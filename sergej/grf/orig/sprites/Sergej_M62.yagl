switch<Trains, 0x14, PrimaryDWord> // clanky (callback 0x16)
{
    expression:
    {
        value1 = variable[0x10] & 0x000000FF;
    };
    ranges:
    {
        0x00000001: 0x8101;
        0x00000002: 0x8102;
    };
    default: 0xFFFF;
}
switch<Trains, 0x15, PrimaryDWord> // hlava: clanky nebo grafika
{
    expression:
    {
        value1 = variable[0x0C] & 0x0000FFFF;
    };
    ranges:
    {
        0x00000016: 0x0014;
    };
    default: 0x0010;
}
switch<Trains, 0x16, PrimaryDWord> // nakup: clanky, popis, obrazek
{
    expression:
    {
        value1 = variable[0x0C] & 0x0000FFFF;
    };
    ranges:
    {
        0x00000016: 0x0014;
        0x00000023: 0x8001;
    };
    default: 0x0013;
}
