switch<Trains, 0x14, PrimaryDWord> // clanky (callback 0x16)
{
    expression:
    {
        value1 = variable[0x10] & 0x000000FF;
    };
    ranges:
    {
        0x00000001: 0x8101;
        0x00000002: 0x8102;
    };
    default: 0xFFFF;
}
switch<Trains, 0x18, PrimaryDWord> // jizda, pasmo 0 (0.78x, -10.0 LUFS)
{
    expression:
    {
        value1 = variable[0x0A] & 0x0000FFFF / 0x00000070;
        value2 = variable[0x1A] & 0x00000004;
        value1 = UnsignedMod(value1, value2);
    };
    ranges:
    {
        0x00000000: 0x804B;
        0x00000001: 0x804C;
        0x00000002: 0x804D;
        0x00000003: 0x804E;
    };
    default: 0x804B;
}
