grf // Action08
{
    grf_id: "MAXc";
    version: GRF8;
    name: "{red}M62 Sergej{green} for ottd Decouple by Karel Macha {lt-blue}{train}";
    description: "{red}M62 Sergej{green}  {train} {new-line}{green}M62 Tamtam tajgy, Sergej ČSD, Maša РЖД  {lt-blue}{train}  {train}  {train}{new-line}{lt-blue}BRÝLE, magnified +20 %, 14/8 tiles, for the original game tracks, sprites in 4x and 8x zoom{new-line}{orange}Three M62 diesels: the green international one, the red ČSD one and the red and grey Russian РЖД one (Маша). The engine roars louder with speed, the horn sounds on departure and at a honk waypoint.{new-line}{orange}3D: Diesel locomotive M62, Chicken cutlet (sketchfab.com/Chicken_Cutlet), CC BY 4.0; РЖД livery: Teplovoz-m62 РЖД, Leafia dev. (sketchfab.com/Leaf_dev), CC BY 4.0{new-line}{orange}Sounds: alexdarek (CC0), Walking.With.Microphones (CC BY 4.0), freesound.org{new-line}{new-line}{green}ottd decouple by Karel Mácha {lt-blue}{train}{new-line}{green}https://karel-macha.itch.io/openttd-decouple-by-karel-macha{new-line}{green}GRF: Karel Mácha, licence CC BY 4.0";
}
strings<Trains, default, 0xD001*> // Action04, popisy v nakupnim okne
{
    /* 0xD001 */ "{lt-green}M62, mezinárodní. Dvoutakt z německé ponorky. V SSSR М62 Машка, v Polsku ST44 Gagarin, v Maďarsku Szergej, v Německu (NDR) V 200 / 120 Taigatrommel, tamtam tajgy.{new-line}{green}ottd Decouple by Karel Mácha{new-line}https://karel-macha.itch.io/openttd-decouple-by-karel-macha{black}{new-line}Určení: {gold}nákladní a osobní vlaky{black}{new-line}Výrobce: {gold}Luhansk{black}{new-line}Motor: {gold}14D40, dvanáctiválcový dvoutakt{black}{new-line}Uspořádání: {gold}Co'Co'{black}{new-line}Délka: {gold}17,55 m{black}{new-line}Model: {gold}Chicken cutlet (Sketchfab), CC BY 4.0";
    /* 0xD002 */ "{lt-green}T 679.1, dieslová. ČSD, od roku 1988 řada 781, přezdívaná Sergej. Dvoutakt z německé ponorky, vyrobený v Rusku.{new-line}{green}ottd Decouple by Karel Mácha{new-line}https://karel-macha.itch.io/openttd-decouple-by-karel-macha{black}{new-line}Určení: {gold}nákladní a osobní vlaky{black}{new-line}Motor: {gold}14D40, dvanáctiválcový dvoutakt{black}{new-line}Uspořádání: {gold}Co'Co'{black}{new-line}Délka: {gold}17,55 m{black}{new-line}Model: {gold}Chicken cutlet (Sketchfab), CC BY 4.0";
    /* 0xD003 */ "{lt-green}M62 v nátěru РЖД (Российские железные дороги, Ruské železnice). V Rusku Маша, Машка. Dvoutakt z německé ponorky.{new-line}{green}ottd Decouple by Karel Mácha{new-line}https://karel-macha.itch.io/openttd-decouple-by-karel-macha{black}{new-line}Určení: {gold}nákladní a osobní vlaky{black}{new-line}Výrobce: {gold}Luhansk{black}{new-line}Motor: {gold}14D40, dvanáctiválcový dvoutakt{black}{new-line}Uspořádání: {gold}Co'Co'{black}{new-line}Délka: {gold}17,55 m{black}{new-line}Model: {gold}Chicken cutlet (Sketchfab), CC BY 4.0, nátěr РЖД: Leafia dev. (Sketchfab), CC BY 4.0";
}
