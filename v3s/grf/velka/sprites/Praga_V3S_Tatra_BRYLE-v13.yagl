yagl_version: "";
grf_format: Container2;
optional_info // Action14, dotazy na nasi hru: dvoubajtova cisla bloku (bit 9) a zamek (bit 8)
{
    FTST: 
    {
        NAME: default, "decouple_more_action2_ids";
        MINV: [ 0x01 0x00 ];
        SETP: [ 0x09 ];
    }
    FTST: 
    {
        NAME: default, "decouple_128_cargo";
        MINV: [ 0x01 0x00 ];
        SETP: [ 0x08 ];
    }
}
optional_info // Action14
{
    INFO: 
    {
        URL_: default, "https://karel-macha.itch.io/openttd-decouple-by-karel-macha";
        VRSN: [ 0x0D 0x00 0x00 0x00 ];
        MINV: [ 0x01 0x00 0x00 0x00 ];
        NPAR: [ 0x00 ];
        PALS: [ 0x44 ];
        BLTR: [ 0x33 ];
    }
}
grf // Action08
{
    grf_id: "MAXe";
    version: GRF8;
    name: "{yellow}V3S Praga, Tatra 148, 138{green} ottd Decouple by Karel Macha {lt-blue}{truck}";
    description: "{yellow}V3S Praga, Tatra 148, Tatra 138{green}  {truck} {new-line}{green}Praga V3S green, Praga V3S blue  {lt-blue}{truck}  {truck}  {truck}{new-line}{orange}Carries everything and rides on railway wagons.{new-line}{orange}The legendary vejtřaska, the 6×6 workhorse of Czechoslovakia from 1953 to 1990. Its Tatra 912 diesel is cooled by air, with no radiator: an axial fan blows over the finned cylinders. It is half of the Tatra 111 V12, an inline six of 7.4 litres. It roars when pulling away and leaves the depot with a two-tone horn. The load shows on the bed as a heap, logs or a tarp. The Praga V3S worked in farming, construction and industry and built socialism.{new-line}{green}Tatra 148 orange, Tatra 138 red  {lt-blue}{truck}{new-line}{orange}Tatra 148 and 138, the orange and red Czechoslovak 6×6 trucks: a tipper for coal, ore and stone, a flatbed with wooden sides for crops, animals and goods, a tarp for steel, a tank for liquids (blue water, milk and oil, white petrol, yellow chemicals, black crude oil), beer in barrels or in a Plzeň (white) or Budvar (blue) tank. With uranium, food, military equipment or explosives it turns army green, and animals, crops, wood, bricks, building supplies, cigars, tobacco and alcohol can ride in a green one too. Air-cooled Tatra V8, 71 km/h.{new-line}{orange}3D: hans1240 (Praga V3S, Tatra 148, Tatra 138), sketchfab.com/hans1240, CC BY 4.0{new-line}{orange}Students: kiemtruongkts, Rotmill, Tatenashi (Sketchfab), CC BY 4.0{new-line}{new-line}{green}for ottd Decouple by Karel Mácha {lt-blue}{truck}{new-line}{green}OpenTTD where trains couple and uncouple on the move{new-line}{green}https://karel-macha.itch.io/openttd-decouple-by-karel-macha{new-line}{green}GRF: Karel Mácha, licence CC BY 4.0{new-line}{black}The green ones ran in civilian life too, sold off from army stock.";
}
if_act7 (is_bit_set(global_var[0x9D] & 0xFF, 1 << 8)) // Action07, zamek: nase hra hlasku preskoci
{
    skip_sprites: 0x01;
}
error_message<Fatal, default, 0xFF> // Action0B
{
    message: "Tento GRF patří ke hře OpenTTD decouple by Karel Mácha a jinde nefunguje.";
}
