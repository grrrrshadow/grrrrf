strings<RoadVehicles, default, 0xD001*> // Action04, popisy v nakupnim okne
{
    /* 0xD001 */ "{lt-green}Praga V3S, vejtřaska. Vojenský valník 6×6, vozí vojáky na korbě, jídlo, výbušniny a skoro všechno ostatní.{new-line}{green}ottd Decouple by Karel Mácha{new-line}https://karel-macha.itch.io/openttd-decouple-by-karel-macha{black}{new-line}Výrobce: {gold}Praga, od 1964 Avia{black}{new-line}Motor: {gold}Tatra 912, řadový šestiválec 7,4 l{black}{new-line}Uspořádání: {gold}6×6{black}{new-line}Nosnost: {gold}5 t na silnici, 3 t v terénu{black}{new-line}Délka: {gold}6,91 m{black}{new-line}Model: {gold}hans1240 (Sketchfab), CC BY 4.0";
    /* 0xD002 */ "{lt-green}Praga V3S, vejtřaska. Civilní modrý valník, odstín podle nákladu: světlá stavby, tmavá strojírenství, zemědělství a zboží. V kabině tři lidi, na korbě skoro všechno.{new-line}{green}ottd Decouple by Karel Mácha{new-line}https://karel-macha.itch.io/openttd-decouple-by-karel-macha{black}{new-line}Výrobce: {gold}Praga, od 1964 Avia{black}{new-line}Motor: {gold}Tatra 912, řadový šestiválec 7,4 l{black}{new-line}Uspořádání: {gold}6×6{black}{new-line}Nosnost: {gold}5 t na silnici, 3 t v terénu{black}{new-line}Délka: {gold}6,91 m{black}{new-line}Model: {gold}hans1240 (Sketchfab), CC BY 4.0";
}
