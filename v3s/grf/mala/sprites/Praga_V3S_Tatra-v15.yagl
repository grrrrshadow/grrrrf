switch<RoadVehicles, 0x27, PrimaryDWord> // vrstvy: T138_valnik a pres ni GOOD (valnik)
{
    expression:
    {
        value1 = variable[0x1A] & 0x00000001;
        value2 = variable[0x10] >> 8 & 0x000000FF;
        value1 = Subtraction(value1, value2);
        value2 = variable[0x1A] & 0x0000001F;
        value1 = ShiftLeft(value1, value2);
        value2 = variable[0x1A] & 0x00000100;
        value1 = TempStore(value1, value2);
        value2 = variable[0x10] >> 8 & 0x000000FF;
        value1 = Assign(value1, value2);
    };
    ranges:
    {
        0x00000001: 0x00C7;
    };
    default: 0x0010;
}
