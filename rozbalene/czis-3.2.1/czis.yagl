// Record #1
optional_info // Action14
{
    INFO: 
    {
        DESC: cs_CZ, "{orange}CZIS: CZech Industry Set{new-line}{black} Navržen od ghebeeka (github uživatel matematysek), založen na kódu FIRS 4 od andythenorth, FooBar, planetmaker, Terkhen a Yexo, s pomocí dalších. {lt-gray}V readme jsou další informace včetně návodu. {black}Licence: GPL v2."; // Czech
        URL_: default, "https://github.com/matematysek/CZIS"; // Default
        VRSN: [ 0x45 0x1F 0x00 0x00 ];
        MINV: [ 0x45 0x1F 0x00 0x00 ];
        NPAR: [ 0x06 ];
        PARA: 
        {
            0x00000000: 
            {
                NAME: default, "Prevent industries opening during gameplay"; // Default
                NAME: cs_CZ, "Zabránění otevírání nových průmyslových budov"; // Czech
                DESC: default, "By default, new industries will open during the game.{new-line}{new-line}If {lt-gray}prevent opening {black}is turned on industries will not open during game, and players will not be able to fund or prospect for industries."; // Default
                DESC: cs_CZ, "Standardně vznikají nové budovy průmyslů.{new-line}{new-line}Pokud je {lt-gray}zabránění otevírání {black}zapnuto, hráč nebude moci zakládat nové budovy ani nebudou vznikat samy od sebe."; // Czech
                TYPE: [ 0x01 ];
                MASK: [ 0x02 0x02 0x01 ];
            }
            0x00000001: 
            {
                NAME: default, "DEPRECATED (No longer used)"; // Default
                NAME: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                DESC: default, "DEPRECATED (No longer used)"; // Default
                DESC: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                MASK: [ 0x07 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000002: 
            {
                NAME: default, "DEPRECATED (No longer used)"; // Default
                NAME: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                DESC: default, "DEPRECATED (No longer used)"; // Default
                DESC: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                MASK: [ 0x09 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000003: 
            {
                NAME: default, "DEPRECATED (No longer used)"; // Default
                NAME: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                DESC: default, "DEPRECATED (No longer used)"; // Default
                DESC: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                MASK: [ 0x06 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000004: 
            {
                NAME: default, "DEPRECATED (No longer used)"; // Default
                NAME: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                DESC: default, "DEPRECATED (No longer used)"; // Default
                DESC: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                MASK: [ 0x08 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000005: 
            {
                NAME: default, "Maximum coastal distance of marine industries in tiles"; // Default
                NAME: cs_CZ, "Maximální vzdálenost námořních průmyslů od pobřeží. (tiles)"; // Czech
                DESC: default, "Maximum distance of fishing grounds, oil rigs and dredging sites from the coast in tiles."; // Default
                DESC: cs_CZ, "Maximální vzdálenost námořních průmyslů od pobřeží. (tiles)"; // Czech
                MASK: [ 0x04 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 ];
                VALU: 
                {
                    0x00000000: default, "DEPRECATED (No longer used)"; // Default
                    0x00000000: cs_CZ, "JIŽ NEPOUŽÍVÁNO"; // Czech
                }
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
        }
        PALS: [ 0x44 ];
        BLTR: [ 0x38 ];
    }
}
// Record #2
grf // Action08
{
    grf_id: "MG\x10\x02";
    version: GRF8;
    name: "CZIS 3.2.1";
    description: "{orange}CZIS: CZech Industry Set{new-line}{black} Designed by ghebeek (github user matematysek), based on FIRS 4 code by andythenorth, FooBar, planetmaker, Terkhen and Yexo, with help from many others. {lt-gray}See readme for more information, including how to use CZIS. {black}License: GPL v2.";
}
