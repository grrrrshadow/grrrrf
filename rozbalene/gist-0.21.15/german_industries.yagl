yagl_version: "";
grf_format: Container2;
// Record #1
optional_info // Action14
{
    INFO: 
    {
        DESC: de_DE, "Deutsche Industrien für OpenTTD{new-line}©2025{new-line}Basiert auf FIRS v5 von andythenorth et al.{new-line}Lizenz: GPLv2, CC-BY-NC-SA v4.0"; // German
        VRSN: [ 0x00 0x00 0x00 0x00 ];
        MINV: [ 0x00 0x00 0x00 0x00 ];
        NPAR: [ 0x21 ];
        PARA: 
        {
            0x00000000: 
            {
                NAME: default, "Economy model"; // Default
                NAME: de_DE, "Wirtschaftsmodell"; // German
                DESC: default, "The realistic economy model models historic industry availability and productivity improvements. The simple economy does not restrict industries based on real economic history. More detailed information can be found in the documentation."; // Default
                DESC: de_DE, "Das realistische Modell simuliert historische Verfügbarkeiten und Produktivitätsverbesserungen. Das einfache Modell ignoriert die Geschichte der realen Wirtschaft. Genauere Informationen können in der Doku nachgelesen werden."; // German
                MASK: [ 0x00 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00 ];
                VALU: 
                {
                    0x00000000: default, "Simple (constant) economy."; // Default
                    0x00000000: de_DE, "Einfache (konstante) Wirtschaft."; // German
                    0x00000001: default, "Realistic economy."; // Default
                    0x00000001: de_DE, "Realistische Wirtschaft"; // German
                }
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000001: 
            {
                NAME: default, "Industries may require electricity"; // Default
                NAME: de_DE, "Industrien benötigen elektrische Energie."; // German
                DESC: default, "When enabled, industries may require electricity to produce anything. Electricity is generated by power plants, but they in turn require deliveries to do so."; // Default
                DESC: de_DE, "Einige Industrien benötigen Strom um etwas produzieren zu können. Strom wird von Kraftwerken produziert, die wiederum beliefert werden müssen."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x01 0x00 0x01 ];
            }
            0x00000002: 
            {
                NAME: default, "Forbid industry generation"; // Default
                NAME: de_DE, "Verbiete Erzeugung von Industrien"; // German
                DESC: default, "When enabled, no industries will spawn during gameplay. Industries will be generated at map generation and can be funded/prospected by the player."; // Default
                DESC: de_DE, "Wenn diese Option aktiviert ist, werden Industrien nur noch während des Spielstarts zusammen mit der Karte generiert. Der Spieler kann weiterhin neue Industrien finanzieren."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x02 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000003: 
            {
                NAME: default, "Forbid industry closure"; // Default
                NAME: de_DE, "Verbiete das Schließen von Industrien."; // German
                DESC: default, "When enabled, no industries will close during gameplay. Extractive industries like mines will still close once they run out of materials to produce. Even with closures enabled, industries that are being served will not close."; // Default
                DESC: de_DE, "Wenn diese Option aktiviert ist, werden Industrien nicht schließen. Minen und ähnliche Industrien werden trotzdem schließen, wenn sie keine Materialien mehr fördern können. Selbst wenn Schließungen erlaubt sind, werden keine Industrien schließen solange sie beliefert werden."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x03 0x00 0x01 ];
                DFLT: [ 0x01 0x00 0x00 0x00 ];
            }
            0x00000004: 
            {
                NAME: default, "Forbid industry closure for last industry on map"; // Default
                NAME: de_DE, "Verbiete das Schließen der einzigen Industrie eines Types."; // German
                DESC: default, "When enabled, industries will not be closed if they are the only instance of that industry on the map. Only has an effect if closures of industries are enabled in general."; // Default
                DESC: de_DE, "Wenn diese Option aktiviert ist, werden Industrien nicht schließen, wenn es nur eine einzige Instanz der Industrie auf der Karte gibt. Hat nur einen Effekt wenn das Schließen von Industrien erlaubt ist."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x04 0x00 0x01 ];
                DFLT: [ 0x01 0x00 0x00 0x00 ];
            }
            0x00000005: 
            {
                NAME: default, "Limit the number of industries on the map."; // Default
                NAME: de_DE, "Begrenze die Anzahl der Industrien."; // German
                DESC: default, "When set to a non-zero value, the number of industries spawned are limited by that value. This is counted for all industries on the map and does not impact map generation, only random industry creation during gameplay."; // Default
                DESC: de_DE, "Wenn ein Wert größer als 0 gesetzt ist, wird die Anzahl der Industrien auf der Karte durch diesen Wert begrenzt. Es werden alle Industrien auf der Karte gezählt, das Limit betrifft nur die zufällige Gründung neuer Industrien während des Spiels."; // German
                MASK: [ 0x05 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x00 0x40 0x00 0x00 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000006: 
            {
                NAME: default, "Limit the number of industries per type."; // Default
                NAME: de_DE, "Begrenze die Anzahl der Industrien pro Industrietyp."; // German
                DESC: default, "When set to a non-zero value, the number of industries spawned are limited by that value. This is counted per industry type and does not impact map generation, only random industry creation during gameplay."; // Default
                DESC: de_DE, "Wenn ein Wert größer als 0 gesetzt ist, wird die Anzahl der Industrien auf der Karte durch diesen Wert begrenzt. Es wird für jeden Industrietyp einzeln gezählt, das Limit betrifft nur die zufällige Gründung neuer Industrien während des Spiels."; // German
                MASK: [ 0x06 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x80 0x00 0x00 0x00 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000007: 
            {
                NAME: default, "Minimum distance between two industries of the same type."; // Default
                NAME: de_DE, "Mindestabstand zweier Industrien des gleichen Typs."; // German
                DESC: default, "Minimum distance between two industries of the same type."; // Default
                DESC: de_DE, "Mindestabstand zweier Industrien des gleichen Typs."; // German
                MASK: [ 0x07 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x80 0x00 0x00 0x00 ];
                DFLT: [ 0x10 0x00 0x00 0x00 ];
            }
            0x00000008: 
            {
                NAME: default, "Minimum distance between two related industries."; // Default
                NAME: de_DE, "Mindestabstand zweier verbundener Industrien"; // German
                DESC: default, "Minimum distance between two related industries. Related means that one industry produces something that the other accepts, creating a possible transport connection. Higher values may cause the map generation to not be able to place all industries."; // Default
                DESC: de_DE, "Mindestabstand zweier verbundener Industrien. Verbunden bedeutet, dass eine Industrie etwas produziert, was die andere akzeptiert, so dass es zwischen beiden eine mögliche Transportverbindung gibt. Größere Werte können dafür sorgen, dass bei der Kartengenerierung nicht alle Industrien platziert werden können."; // German
                MASK: [ 0x08 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x80 0x00 0x00 0x00 ];
                DFLT: [ 0x20 0x00 0x00 0x00 ];
            }
            0x00000009: 
            {
                NAME: default, "Behavior when reaching stockpile limit"; // Default
                NAME: de_DE, "Verhalten wenn zu viele Rohstoffe in einer Industrie warten"; // German
                DESC: default, "Define what to do when the stockpile limit is reached. When set to discard, incoming freight will be discarded. The delivery will be paid, the cargo will simply vanish. When set to stop acceptance, the industry will stop simply not accept the cargo, the vehicle will not be able to unload. See documentation for more details."; // Default
                DESC: de_DE, "Bestimmt das Verhalten für den Fall, dass das Lagerlimit für eine Industrie erreicht wird. Wenn man es auf Verwerfen stellt, werden weitere angelieferter Güter verworfen. Die Anlieferung wird aber bezahlt. Wenn man es auf Annahme verweigern stellt, wird die Industrie die Lieferung nicht akzeptieren, das liefernde Fahrzeug kann dann nicht abladen. Die Dokumentation enthält eine genauere Beschreibung."; // German
                MASK: [ 0x09 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00 ];
                VALU: 
                {
                    0x00000000: default, "Discard"; // Default
                    0x00000000: de_DE, "Verwerfen"; // German
                    0x00000001: default, "Stop acceptance"; // Default
                    0x00000001: de_DE, "Annahme verweigern"; // German
                }
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x0000000A: 
            {
                NAME: default, "Primary industry production scale"; // Default
                NAME: de_DE, "Skalierung der Produktion von Primärindustrien"; // German
                DESC: default, "Scales the monthly production scale of primary industries. 100% is the default and matches the standard industries."; // Default
                DESC: de_DE, "Skaliert die monatliche Produktion von Primärindustrien. 100% ist voreingestellt und entspricht den originalen Industrien."; // German
                MASK: [ 0x0A ];
                LIMI: [ 0x01 0x00 0x00 0x00 0xF4 0x01 0x00 0x00 ];
                DFLT: [ 0x64 0x00 0x00 0x00 ];
            }
            0x0000000B: 
            {
                NAME: default, "Primary industry resources factor"; // Default
                NAME: de_DE, "Skalierung der Ressourcen von Primärindustrien"; // German
                DESC: default, "Scales the amount of resources that a primary industry can excavate. Once the resources are depleted the industry will close."; // Default
                DESC: de_DE, "Skaliert die Menge an Ressourcen, die eine Primärindustrie fördern kann. Wenn die Ressourcen erschöpft sind, schließt die Industrie."; // German
                MASK: [ 0x0B ];
                LIMI: [ 0x01 0x00 0x00 0x00 0x32 0x00 0x00 0x00 ];
                DFLT: [ 0x05 0x00 0x00 0x00 ];
            }
            0x0000000C: 
            {
                NAME: default, "Maximum production of primary industries per production cycle."; // Default
                NAME: de_DE, "Maximale Production von Primärindustrien pro Produktionszyklus."; // German
                DESC: default, "Defines the maximum production per production cycle for primary industries (e.g. mines). The maximum monthly production is 8-9 times this value with default time scaling. Scaling the primary industry production will also scale this maximum value."; // Default
                DESC: de_DE, "Definiert die maximale Produktion von Primärindustrien wie Bergwerken. Die maximale monatliche Produktion ist das 8-9 fache dieses Wertes. Die Skalierung der Primärindustrien skaliert auch diesen Maximalwert."; // German
                MASK: [ 0x0C ];
                LIMI: [ 0x40 0x00 0x00 0x00 0xFF 0xFF 0x00 0x00 ];
                DFLT: [ 0xFF 0xFF 0x00 0x00 ];
            }
            0x0000000D: 
            {
                NAME: default, "Transport percentage required to increase primary industry production."; // Default
                NAME: de_DE, "Benötigte Transportquote für Produktionserhöhung primärer Industrien."; // German
                DESC: default, "You need to transport at least this percentage of the production of a primary industry to allow the industry to increase production."; // Default
                DESC: de_DE, "Der Prozentsatz an transportierter Fracht, den man erreichen muss um die Produktion einer Primärindustrie (z.B. Bergwerk) zu erhöhen."; // German
                MASK: [ 0x0D ];
                LIMI: [ 0x32 0x00 0x00 0x00 0x50 0x00 0x00 0x00 ];
                DFLT: [ 0x3C 0x00 0x00 0x00 ];
            }
            0x0000000E: 
            {
                NAME: default, "Adaptation speed for primary industry production."; // Default
                NAME: de_DE, "Geschwindigkeit, in der Primärindustrien die Produktion verändern."; // German
                DESC: default, "This value defines how fast and how often a primary industry (such as a mine) will change production if the required conditions are fulfilled."; // Default
                DESC: de_DE, "Dieser Wert bestimmt, wie schnell und wie oft eine Primärindustrie (z.B. Bergwerk) die Produktion verändert wenn die notwendigen Voraussetzungen erfüllt sind."; // German
                MASK: [ 0x0E ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x03 0x00 0x00 0x00 ];
                VALU: 
                {
                    0x00000000: default, "Very Fast"; // Default
                    0x00000000: de_DE, "Sehr schnell"; // German
                    0x00000001: default, "Fast"; // Default
                    0x00000001: de_DE, "Schnell"; // German
                    0x00000002: default, "Medium"; // Default
                    0x00000002: de_DE, "Mittel"; // German
                    0x00000003: default, "Slow"; // Default
                    0x00000003: de_DE, "Langsam"; // German
                }
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x0000000F: 
            {
                NAME: default, "Extension set {dq}Building Industries{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Bauindustrie{dq}"; // German
                DESC: default, "Adds cargos related to building, such as limestone and cement, as well as the related industries."; // Default
                DESC: de_DE, "Fügt Frachten wie Kalkstein und Zement und passende Industrien hinzu."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x0F 0x00 0x01 ];
            }
            0x00000010: 
            {
                NAME: default, "Extension set {dq}Textile Industries{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Textilindustrie{dq}"; // German
                DESC: default, "Adds cargos related to textile and clothing production, such as wool and textiles, as well as the related industries."; // Default
                DESC: de_DE, "Fügt Frachten wie Wolle und Textilien und passende Industrien hinzu."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x10 0x00 0x01 ];
            }
            0x00000011: 
            {
                NAME: default, "Extension set {dq}Aluminium{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Aluminium{dq}"; // German
                DESC: default, "Adds aluminium production from bauxite and extends other industries to require aluminium."; // Default
                DESC: de_DE, "Fügt Aluminiumproduktion aus Bauxit hinzu und erweitert andere Industrien, dass sie Aluminium benötigen."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x11 0x00 0x01 ];
            }
            0x00000012: 
            {
                NAME: default, "Extension set {dq}Basic Inorganic Chemistry{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Grundlegende Anorganische Chemie{dq}"; // German
                DESC: default, "Adds basic chemistry based on sodium and chlorine, as well as related industries."; // Default
                DESC: de_DE, "Fügt Chemikalien wie Natronlauge und Chlor und passende Industrien hinzu."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x12 0x00 0x01 ];
            }
            0x00000013: 
            {
                NAME: default, "Extension set {dq}Painting Industries{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Farbindustrie{dq}"; // German
                DESC: default, "Adds chemical industries producing paints from various raw materials."; // Default
                DESC: de_DE, "Fügt Chemiebetriebe hinzu, die aus verschiedenen Rohstoffen Farben produzieren."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x13 0x00 0x01 ];
            }
            0x00000014: 
            {
                NAME: default, "Extension set {dq}Food Industries{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Lebensmittelindustrie{dq}"; // German
                DESC: default, "Adds more diverse food processing industries."; // Default
                DESC: de_DE, "Fügt eine breitere Palette an Lebensmittelindustrien hinzu."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x14 0x00 0x01 ];
            }
            0x00000015: 
            {
                NAME: default, "Extension set {dq}Packaging Industries{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Verpackungsindustrie{dq}"; // German
                DESC: default, "Adds additional packaging cargo to be delivered to industries producting food or goods."; // Default
                DESC: de_DE, "Fügt Verpackungen als Fracht hinzu, die zu Industrien geliefert werden müssen, welche Waren oder Nahrungsmittel herstellen."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x15 0x00 0x01 ];
            }
            0x00000016: 
            {
                NAME: default, "Extension set {dq}Glass production{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Glasindustrie{dq}"; // German
                DESC: default, "Adds industries and cargos related to the production of glass.{new-line}{new-line}Requires the extension {dq}Building industries{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die für die Glasproduktion relevant sind.{new-line}{new-line}Erfordert die Erweiterung {dq}Bauindustrie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x16 0x00 0x01 ];
            }
            0x00000017: 
            {
                NAME: default, "Extension set {dq}Paper production{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Papierindustrie{dq}"; // German
                DESC: default, "Adds industries that produce or require paper.{new-line}{new-line}Requires the extension {dq}Basic inorganic chemistry{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien hinzu, die Papier produzieren bzw. benötigen.{new-line}{new-line}Erfordert die Erweiterung {dq}Grundlegende Anorganische Chemie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x17 0x00 0x01 ];
            }
            0x00000018: 
            {
                NAME: default, "Extension set {dq}Organic Chemistry{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Organische Chemie{dq}"; // German
                DESC: default, "Adds industries and cargos related to the processing of crude oil.{new-line}{new-line}Requires the extension {dq}Basic inorganic chemistry{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die sich mit der Verarbeitung von Erdöl beschäftigen.{new-line}{new-line}Erfordert die Erweiterung {dq}Grundlegende Anorganische Chemie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x18 0x00 0x01 ];
            }
            0x00000019: 
            {
                NAME: default, "Extension set {dq}Coke and Sulphur{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Koks und Schwefel{dq}"; // German
                DESC: default, "Adds industries and cargos related to the processing of ores containing sulphur.{new-line}{new-line}Requires the extensions {dq}Basic inorganic chemistry{dq} and {dq}Painting Industries{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die sich mit der Förderung und Verarbeitung von schwefelhaltigen Erzen beschäftigen.{new-line}{new-line}Erfordert die Erweiterungen {dq}Grundlegende anorganische Chemie{dq} und {dq}Farbindustrie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x19 0x00 0x01 ];
            }
            0x0000001A: 
            {
                NAME: default, "Extension set {dq}Ammonia synthesis{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Ammoniaksynthese{dq}"; // German
                DESC: default, "Adds industries and cargos related to the synthesis of ammonia.{new-line}{new-line}Requires the extensions {dq}Basic inorganic chemistry{dq} or {dq}Building Industries{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die sich mit der Synthese von Ammoniak beschäftigen.{new-line}{new-line}Erfordert die Erweiterungen {dq}Grundlegende anorganische Chemie{dq} oder {dq}Bauindustrie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x1A 0x00 0x01 ];
            }
            0x0000001B: 
            {
                NAME: default, "Extension set {dq}Fruits and Bio Energy{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Früchte und Bioenergie{dq}"; // German
                DESC: default, "Adds industries and cargos related to the harvesting of fruits and the usage of regenerative energy sources.{new-line}{new-line}Requires the extensions {dq}Organic chemistry{dq} and {dq}Basic inorganic chemistry{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die sich mit der Verwertung von Bioabfällen beschäftigen.{new-line}{new-line}Erfordert die Erweiterungen {dq}Organische Chemie{dq} und {dq}Grundlegende anorganische Chemie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x1B 0x00 0x01 ];
            }
            0x0000001C: 
            {
                NAME: default, "Extension set {dq}Metallurgy{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Metallurgie{dq}"; // German
                DESC: default, "Adds industries and cargos related to heavy industries and production of sheets, cables and other metal-based products.{new-line}{new-line}Requires the extensions {dq}Coke and Sulphur{dq}, {dq}Basic inorganic chemistry{dq} and {dq}Painting industries{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die sich mit der Herstellung von Metallproduktion beschäftigen.{new-line}{new-line}Erfordert die Erweiterungen {dq}Koks und Schwefel{dq}, {dq}Grundlegende anorganische Chemie{dq} und {dq}Farbindustrie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x1C 0x00 0x01 ];
            }
            0x0000001D: 
            {
                NAME: default, "Extension set {dq}Recycling{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Recycling{dq}"; // German
                DESC: default, "Adds industries and cargos related to the recycling of scrap materials."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die sich mit dem Recycling von Wertstoffen beschäftigen."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x1D 0x00 0x01 ];
            }
            0x0000001E: 
            {
                NAME: default, "Extension set {dq}Vehicle Industries{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Automobilbau{dq}"; // German
                DESC: default, "Adds industries and cargos related to the creation of vehicles.{new-line}{new-line}Requires the extensions {dq}Coke and Sulphur{dq}, {dq}Basic inorganic chemistry{dq} and {dq}Painting industries{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien und Frachten hinzu, die mit Automobilbau zusammenhängen.{new-line}{new-line}Erfordert die Erweiterungen {dq}Koks und Schwefel{dq}, {dq}Grundlegende anorganische Chemie{dq} und {dq}Farbindustrie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x1E 0x00 0x01 ];
            }
            0x0000001F: 
            {
                NAME: default, "Extension set {dq}Production boost{dq}"; // Default
                NAME: de_DE, "Erweiterung {dq}Produktionsbooster{dq}"; // German
                DESC: default, "Adds industries to that support the production of fertilizers and explosives, which in turn are used to increase production of primary industries.{new-line}{new-line}Requires the extensions {dq}Ammonia synthesis{dq} and {dq}Coke and Sulphur{dq} to be activated.{new-line}Extension {dq}Ammonia Synthesis{dq} requires the extensions {dq}Basic inorganic chemistry{dq} or {dq}Building Industries{dq} to be activated.{new-line}Extension {dq}Coke and Sulphur{dq} requires the extensions {dq}Basic inorganic chemistry{dq} and {dq}Painting Industries{dq} to be activated."; // Default
                DESC: de_DE, "Fügt Industrien hinzu, die der Produktion von Dünger und Sprengstoff dienen, mit denen man die Produktion von Primärindustrien erhöhen kann.{new-line}{new-line}Erfordert die Erweiterungen {dq}Ammoniaksynthese{dq} und {dq}Koks und Schwefel{dq}.{new-line}Die Erweiterung {dq}Ammoniaksynthese{dq} benötigt die Erweiterungen {dq}Grundlegende anorganische Chemie{dq} oder {dq}Bauindustrie{dq}.{new-line}Die Erweiterung {dq}Koks und Schwefel{dq} benötigt die Erweiterungen {dq}Grundlegende anorganische Chemie{dq} und {dq}Farbindustrie{dq}."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x1F 0x00 0x01 ];
            }
            0x00000020: 
            {
                NAME: default, "Skip check for incompatible GRFs"; // Default
                NAME: de_DE, "Überspringe die Prüfung auf inkompatible GRFs"; // German
                DESC: default, "If you really insist on using an incompatible NewGRF you can enable this.{new-line}This will void all warranties, corrupt your savegame, may set your PC on fire and God will kill a kitten. You have been warned."; // Default
                DESC: de_DE, "Wer unbedingt inkompatible Sets benutzen will kann das hiermit tun.{new-line}Das wird zu nicht funktionierenden Industrien und kaputten Spielständen führen, kann den PC zerstören und dein Haus in Brand setzen. Beschwer dich also hinterher nicht."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x20 0x00 0x01 ];
            }
        }
        PALS: [ 0x44 ];
        BLTR: [ 0x38 ];
    }
}
