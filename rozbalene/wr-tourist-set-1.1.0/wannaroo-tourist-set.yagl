                    0x00000002: default, "1/4"; // Default
                    0x00000003: default, "1/8"; // Default
                    0x00000004: default, "1/16"; // Default
                    0x00000005: default, "Minimal (1/32)"; // Default
                }
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x0000000C: 
            {
                NAME: default, "Road vehicle base costs defined by this NewGRF"; // Default
                DESC: default, "Off (default) if another NewGRF is defining road vehicle base costs.{new-line}On if this NewGRF will define them.{new-line}{new-line}Base costs defined: PR_BUILD_VEHICLE_ROAD, PR_RUNNING_ROADVEH"; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x0C 0x00 0x01 ];
