// Record #9
optional_info // Action14
{
    INFO: 
    {
        URL_: default, "https://github.com/jrook1445/wannaroo-tourist-set"; // Default
        VRSN: [ 0x4C 0x04 0x00 0x00 ];
        MINV: [ 0x0A 0x00 0x00 0x00 ];
        NPAR: [ 0x0E ];
        PARA: 
        {
            0x00000000: 
            {
                NAME: default, "Hotel"; // Default
                DESC: default, "The hotel accepts food and alcohol. It also produces and accepts tourists."; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x00 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000001: 
            {
                NAME: default, "Visitor Center"; // Default
                DESC: default, "The visitor center produces and accepts tourists."; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x01 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000002: 
            {
                NAME: default, "Town Square"; // Default
                DESC: default, "The town square produces and accepts tourists, and also accepts goods and alcohol."; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x02 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000003: 
            {
                NAME: default, "Houses"; // Default
                DESC: default, "2 houses (rustic, regular) produce 8 +/- 3 tourists per production tick.{new-line}{new-line}2 tall buildings (tower block, flats) produce 20 +/- 4 tourists per production tick."; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x03 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000004: 
            {
                NAME: default, "Manual placement"; // Default
                DESC: default, "Off (default): industries are placed on map generation and can appear in game. On: industries must be manually placed."; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x04 0x00 0x01 ];
                DFLT: [ 0x01 0x00 0x00 0x00 ];
            }
            0x00000005: 
            {
                NAME: default, "Max Tourist Production"; // Default
                DESC: default, "Maximum tourist production per month: default 160, max 512, min 32{new-line}{new-line}Note: Affects Hotel, Visitor Center, Town Square only. Houses production is fixed."; // Default
                MASK: [ 0x05 ];
                LIMI: [ 0x20 0x00 0x00 0x00 0x00 0x02 0x00 0x00 ];
                DFLT: [ 0xA0 0x00 0x00 0x00 ];
            }
            0x00000006: 
            {
                NAME: default, "Closure protection period"; // Default
                DESC: default, "Industries will be protected from closure for this many months: default 60, max 600, min 0. A value of 0 will disable industry closure."; // Default
                MASK: [ 0x06 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x58 0x02 0x00 0x00 ];
                DFLT: [ 0x3C 0x00 0x00 0x00 ];
            }
            0x00000007: 
            {
                NAME: default, "Debug Text"; // Default
                DESC: default, "Show debug text in the industry windows."; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x07 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000008: 
            {
                NAME: default, "Industry base costs defined by this NewGRF"; // Default
                DESC: default, "Off (default) if another NewGRF is defining industry base costs.{new-line}On if this NewGRF will define them.{new-line}{new-line}Base costs defined: PR_BUILD_INDUSTRY, PR_BUILD_INDUSTRY_RAW, PR_CLEAR_INDUSTRY"; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x08 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000009: 
            {
                NAME: default, "Industry base costs"; // Default
                DESC: default, "Normal or reduced base costs (default = normal)."; // Default
                MASK: [ 0x09 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x05 0x00 0x00 0x00 ];
                VALU: 
                {
                    0x00000000: default, "Normal"; // Default
                    0x00000001: default, "1/2"; // Default
                    0x00000002: default, "1/4"; // Default
                    0x00000003: default, "1/8"; // Default
                    0x00000004: default, "1/16"; // Default
                    0x00000005: default, "Minimal (1/32)"; // Default
                }
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x0000000A: 
            {
                NAME: default, "Train base costs defined by this NewGRF"; // Default
                DESC: default, "Off (default) if another NewGRF is defining train base costs.{new-line}On if this NewGRF will define them.{new-line}{new-line}Base costs defined: PR_BUILD_VEHICLE_TRAIN, PR_BUILD_VEHICLE_WAGON, PR_RUNNING_TRAIN_STEAM, PR_RUNNING_TRAIN_DIESEL, PR_RUNNING_TRAIN_ELECTRIC"; // Default
                TYPE: [ 0x01 ];
                MASK: [ 0x0A 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x0000000B: 
            {
                NAME: default, "Train base costs"; // Default
                DESC: default, "Normal or reduced base costs (default = normal)."; // Default
                MASK: [ 0x0B ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x05 0x00 0x00 0x00 ];
                VALU: 
