switch<Industries, 0xF3, PrimaryDWord> // Action02 variable
{
    expression:
    {
        value1 = variable[0x18] & 0xFFFFFFFF;

        value2 = variable[0x1A] & 0x00000000;
        value1 = SignedCmp(value1, value2);

        value2 = variable[0x1A] & 0x00000001;
        value1 = BitwiseAnd(value1, value2);
    };
    ranges:
    {
        0x00000001: 0x00F3;
    };
    default: 0x8400;
}
