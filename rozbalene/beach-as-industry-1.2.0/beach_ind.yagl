yagl_version: "";
grf_format: Container2;
// Record #1
optional_info // Action14
{
    INFO: 
    {
        DESC: de_DE, "{orange}Strände werden Passagiere produzieren und akzeptieren.{new-line}{new-line}{black}Das {dq}Beach Objects set{dq} ist für die Dekoration empfohlen.{new-line}{new-line}Gezeichnet durch Quast65 und programmiert von 2TallTyler.{new-line}{new-line}Lizens: GPL v3"; // German
        DESC: fr_FR, "{orange}Des plages qui produisent et acceptent les passagers.{new-line}{new-line}{black}Le NewGRF {dq}Beach Objects set{dq} est fortement recommandé pour la décoration.{new-line}{new-line}Dessiné par Quast65 et codé par 2TallTyler.{new-line}{new-line}License: GPL v3"; // French
        DESC: es_ES, "{orange}Playas que producen y aceptan pasajeros..{new-line}{new-line}{black}Se recomienda encarecidamente el set de objetos de playa (Beach Objects set) para decoraciones.{new-line}{new-line}Dibujado por Quast65 y el código por 2TallTyler.{new-line}{new-line}Licencia: GPL v3"; // Spanish
        DESC: sv_SE, "{orange}Stränder som producerar och accepterar passagerare.{new-line}{new-line}{black}NewGRFen {dq}Beach Objects set{dq} rekommenderas starkt för dekoration.{new-line}{new-line}Ritad av Quast65 och kodad av 2TallTyler.{new-line}{new-line}Licens: GPL v3"; // Swedish
        DESC: gl_ES, "{orange}Praias que producen e aceptan pasaxeiros..{new-line}{new-line}{black}Recoméndase encarecidamente o set de obxectos de praia (Beach Objects set) para decoracións.{new-line}{new-line}Debuxado por Quast65 e o código por 2TallTyler.{new-line}{new-line}Licencia: GPL v3"; // Galician
        DESC: es_MX, "{orange}Playas que producen y aceptan pasajeros..{new-line}{new-line}{black}Se recomienda encarecidamente el set de objetos de playa (Beach Objects set) para decoraciones.{new-line}{new-line}Dibujado por Quast65 y el código por 2TallTyler.{new-line}{new-line}Licencia: GPL v3"; // Mexican Spanish
        VRSN: [ 0x06 0x00 0x00 0x00 ];
        MINV: [ 0x03 0x00 0x00 0x00 ];
        NPAR: [ 0x01 ];
        PARA: 
        {
            0x00000000: 
            {
                NAME: default, "Beaches generate during game"; // Default
                NAME: de_DE, "Generiere Strände während des Spielens"; // German
                NAME: fr_FR, "De nouvelles plages sont générées pendant le jeu"; // French
                NAME: es_ES, "Las Playas se generan durante el juego"; // Spanish
                NAME: sv_SE, "Stränder genereras under spelets gång"; // Swedish
                NAME: gl_ES, "As Praias xeranse durante o xogo"; // Galician
                NAME: es_MX, "Las Playas se generan durante el juego"; // Mexican Spanish
                DESC: default, "{white}Off:{black} Beaches generate only during map generation.{new-line}{new-line}{white}On:{black} Beaches generate both during map generation and during the game."; // Default
                DESC: de_DE, "{white}Aus:{black} Strände werden nur während der Spielfeld-Erschaffung gebaut.{new-line}{new-line}{white}An:{black} Strände werden sowohl während der Spielfeld-Erschaffung, als auch während des Spielens gebaut."; // German
                DESC: fr_FR, "{white}Désactivé:{black} Les plages sont uniquement générées pendant la génération de la carte.{new-line}{new-line}{white}Activé:{black} Les plages sont générées pendant la génération de la carte et pendant le jeu."; // French
                DESC: es_ES, "{white}No:{black} Las playas se generan solo durante la generación del mapa.{new-line}{new-line}{white}Si:{black} Las playas se generan durante la generación del mapa y durante el juego"; // Spanish
                DESC: sv_SE, "{white}Av:{black} Stränder genereras bara under världsgenereringen.{new-line}{new-line}{white}På:{black} Stränder genereras både under världsgenereringen och under spelets gång."; // Swedish
                DESC: gl_ES, "{white}Non:{black} As praias xeraranse só durante a xeración do mapa.{new-line}{new-line}{white}Si:{black} As Praias xerarase durante a xeración do mapa e durante o xogo"; // Galician
                DESC: es_MX, "{white}No:{black} Las playas se generan solo durante la generación del mapa.{new-line}{new-line}{white}Si:{black} Las playas se generan durante la generación del mapa y durante el juego"; // Mexican Spanish
                TYPE: [ 0x01 ];
                MASK: [ 0x00 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
        }
        PALS: [ 0x44 ];
        BLTR: [ 0x38 ];
    }
}
