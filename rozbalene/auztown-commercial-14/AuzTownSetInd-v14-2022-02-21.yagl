grf // Action08
{
    grf_id: "GG37";
    version: GRF8;
    name: "Auz Town Commercial Set v14";
    description: "{orange}Update: 15 Feb 2025. Adds Commercial Industries to the towns. They only accept cargos.{new-line}{new-line}Project of: GarryG, Jimbob, Quast65, fridaemon and temporal8 {new-line}License:GPLv2 or higher. {new-line}See readme for details.";
}
