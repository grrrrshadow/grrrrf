    /* 0xD002 */ "Produktion braucht {white}pro Einheit{black} Tabak:{new-line}* 1 Arbeiter{new-line}{new-line}Produktion {white}pro Einheit{black} Tabak:{new-line}* 1 Zigarren";
    /* 0xD003 */ "Monatliche Produktion braucht:{new-line}* {white}Einfache{black}: Keine{new-line}* {white}Doppelte{black}: + 24 Tonnen Dünger";
