yagl_version: "";
grf_format: Container2;
// Record #1
optional_info // Action14
{
    INFO: 
    {
        NAME: zh_TW, "IOTC 加勒比海工業 2.7"; // Chinese (Traditional)
        NAME: zh_CN, "IOTC 加勒比海工业 2.7"; // Chinese (Simplified)
        DESC: de_DE, "{orange}Ein von Kuba inspiriertes Wirtschaftsmodel.{new-line}{new-line}{red}Achtung! {black}Diese Modifikation verändert Kernspielelemente und ist ziemlich schwierig. Bitte besuchen Sie die Internetseite für weitere Informationen.{new-line}{new-line}{black}Entwickelt by 2TallTyler."; // German
        DESC: fr_FR, "{orange}Une économie inspirée de Cuba.{new-line}{new-line}{red}Attention ! {black}Ce mod change les mécaniques du jeu, et est assez difficile. Visiter le site web pour en savoir plus.{new-line}{new-line}{black}Crée par 2TallTyler."; // French
        DESC: zh_TW, "Industries of the Caribbean 是{orange}古巴風格的工業套裝。{new-line}{new-line}{red}警告！ {black}本模組改變了遊戲的核心玩法，難度較大。首次遊玩請訪問主頁閱讀詳細說明。{new-line}{new-line}{black}Created by 2TallTyler"; // Chinese (Traditional)
        DESC: zh_CN, "Industries of the Caribbean 是{orange}古巴风格的工业套装。{new-line}{new-line}{red}警告! {black}本模组改变了游戏的核心玩法，难度较大。首次游玩请访问主页阅读详细说明。{new-line}{new-line}{black}Created by 2TallTyler"; // Chinese (Simplified)
        URL_: default, "https://github.com/2TallTyler/industries_of_the_caribbean/blob/main/README.md"; // Default
        VRSN: [ 0x0E 0x00 0x00 0x00 ];
        MINV: [ 0x0B 0x00 0x00 0x00 ];
        NPAR: [ 0x03 ];
        PARA: 
        {
            0x00000000: 
            {
                NAME: default, "Static cargo payments"; // Default
                NAME: de_DE, "Gleichbleibende Frachtzahlungen"; // German
                NAME: fr_FR, "Prix fixe des cargaisons"; // French
                NAME: zh_TW, "恆定貨物運費"; // Chinese (Traditional)
                NAME: zh_CN, "恒定货物运费"; // Chinese (Simplified)
                DESC: default, "{lt-blue}Default value: {orange}On{new-line}{white}If enabled, cargo delivery payments do not depend on distance transported. This models a market of goods being bought and sold as opposed to transportation payments. Payments are scaled to map size: the larger the map, the greater the payments."; // Default
                DESC: de_DE, "{lt-blue}Standardwert: {orange}An{new-line}{white}Falls aktiviert, hängen Frachtlieferungsvergütungen  nicht von der Entfernung des Transports ab. Dies stellt einen Markt nach auf dem Güter gekauft und verkauft werden, anstatt von Speditionszahlungen. Die Kalkulation richtet sich nach der Größe der Karte: je größer die Karte, desto größer die Leistungen."; // German
                DESC: fr_FR, "{lt-blue}Par défaut: {orange}Activé{new-line}{white}Quand ce paramètre est activé, le paiement des cargaisons ne dépend pas de la distance parcourue. Cela simule un marché de biens achetés et vendus plutôt qu'un prix de transport. Les versements sont proportionnels à la taille de la carte : plus la carte est grande, plus les paiements seront importants."; // French
                DESC: zh_TW, "{lt-blue}默認值：{orange}啟用{new-line}{white}啟用時貨物運費將不取決於運輸的距離。本設置旨在模擬貨物的買賣過程，而不是運輸過程。收入由地圖大小決定。地圖越大，收入越大，反之亦然。"; // Chinese (Traditional)
                DESC: zh_CN, "{lt-blue}默认值：{orange}启用{new-line}{white}启用时货物运费将不取决于运输的距离。本设置旨在模拟货物的买卖过程，而不是运输过程。收入由地图大小决定。地图越大，收入越大，反之亦然。"; // Chinese (Simplified)
                TYPE: [ 0x01 ];
                MASK: [ 0x00 0x00 0x01 ];
                DFLT: [ 0x01 0x00 0x00 0x00 ];
            }
            0x00000001: 
            {
                NAME: default, "Generate primary industries only"; // Default
                NAME: de_DE, "Erschaffe nur Rohstoffbetriebe"; // German
                NAME: fr_FR, "Générer des industries primaires uniquement"; // French
                NAME: zh_TW, "僅生成初級產業"; // Chinese (Traditional)
                NAME: zh_CN, "仅生成初级产业"; // Chinese (Simplified)
                DESC: default, "{lt-blue}Default value: {orange}Off{new-line}{white}If enabled, only primary industries (Coffee Plantation, Sugarcane Plantation, Tobacco Plantation, Oil Wells, Nickel Mine, Beach, Hotel) will generate. Secondary industries must be funded by the player."; // Default
                DESC: de_DE, "{lt-blue}Standardwert: {orange}Aus{new-line}{white}Falls aktiviert, werden nur Betriebe des ersten Sektors erstellt (Kaffeepflanzung, Zuckerrohrpflanzung, Tabakpflanzung, Ölquellen, Nickelmine, Strand, Hotel). Industrien müssen vom Spieler finanziert werden."; // German
                DESC: fr_FR, "{lt-blue}Par défaut: {orange}Désactivé{new-line}{white}Quand ce paramètre est activé, seules des industries priamires (Plantation de Café, de Canne à Sucre et de Tabac, Puits de Pétrole, Mine de Nickel, Plage, Hôtel) seront générées en cours de jeu. Les industries secondaires devront être financées par les joueurs."; // French
                DESC: zh_TW, "{lt-blue}默認值：{orange}關閉{new-line}{white}若關閉、只會生成初級產業（咖啡園、甘蔗園、煙葉園、油井、鎳礦石、度假沙灘、酒店）。二級產業必須由玩家建設。"; // Chinese (Traditional)
                DESC: zh_CN, "{lt-blue}默认值：{orange}关闭{new-line}{white}若关闭、只会生成初级产业（咖啡园、甘蔗园、烟叶园、油井、镍矿石、度假沙滩、酒店）二级产业必须由玩家建设。"; // Chinese (Simplified)
                TYPE: [ 0x01 ];
                MASK: [ 0x01 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
            0x00000002: 
            {
                NAME: default, "Town population per secondary industry"; // Default
                NAME: de_DE, "Stadteinwohnerzahl pro Industrie"; // German
                NAME: fr_FR, "Population par industrie secondaire"; // French
                NAME: zh_TW, "加工廠人口限制"; // Chinese (Traditional)
                NAME: zh_CN, "加工工厂人口限制"; // Chinese (Simplified)
                DESC: default, "{lt-blue}Default value: {orange}500{new-line}{white}The population required to support each secondary industry (Sugar Mill, Cigar Factory, Rum Distillery, Oil Refinery, Nickel Smelter). Does not apply to player-funded industries."; // Default
                DESC: de_DE, "{lt-blue}Standardwert: {orange}500{new-line}{white}Die Bevölkerungszahl, die benötigt wird um jede einzelne Industrie zu versorgen (Zuckerfabrik, Tabakverarbeitung, Rumbrennerei, Ölraffinerie, Nickelschmelze)."; // German
                DESC: fr_FR, "{lt-blue}Par défaut: {orange}500{new-line}{white}La population requise pour chaque industrie secondaire (Raffinerie de Sucre, Fabrique de Cigares, Distillerie de Rhum, Raffinerie Pétrolière, Fonderie de Nickel)."; // French
                DESC: zh_TW, "{lt-blue}默認值：{orange}500{new-line}{white}高於人口設置的城市才會出現加工廠，對所有加工廠都有效（製糖廠、煙草廠、朗姆酒廠、煉油廠、鎳礦加工廠）。不適用於玩家建設的工業。"; // Chinese (Traditional)
                DESC: zh_CN, "{lt-blue}默认值：{orange}500{new-line}{white}高于人口设置的城市才会出现加工工厂，对所有加工工厂都有效（制糖厂、烟草工厂、朗姆酒厂、炼油厂、镍矿加工厂）。不适用于玩家建设的工业。"; // Chinese (Simplified)
                MASK: [ 0x02 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0xFF 0xFF 0xFF 0xFF ];
                DFLT: [ 0xF4 0x01 0x00 0x00 ];
            }
        }
        PALS: [ 0x44 ];
        BLTR: [ 0x38 ];
    }
}
