    version: GRF8;
    name: "Industries of the Caribbean 2.7";
    description: "{orange}A Cuban-inspired economy replacement.{new-line}{new-line}{red}Warning! {black}This mod changes core gameplay aspects, and is quite difficult. Please visit the website to learn more.{new-line}{new-line}{black}Created by 2TallTyler.";
}
