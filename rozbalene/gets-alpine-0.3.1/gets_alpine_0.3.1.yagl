// Record #2
optional_info // Action14
{
    INFO: 
    {
        VRSN: [ 0x03 0x00 0x00 0x00 ];
        MINV: [ 0x24 0x00 0x00 0x00 ];
        NPAR: [ 0x02 ];
        PARA: 
        {
            0x00000000: 
            {
                NAME: default, " Running cost"; // Default
                DESC: default, " Choose between cheaper or higher costs for running trains."; // Default
                MASK: [ 0x00 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x05 0x00 0x00 0x00 ];
                VALU: 
                {
                    0x00000000: default, " the cheapest"; // Default
                    0x00000001: default, " very cheap"; // Default
                    0x00000002: default, " cheap"; // Default
                    0x00000003: default, " default"; // Default
                    0x00000004: default, " high"; // Default
                    0x00000005: default, " very high"; // Default
                }
                DFLT: [ 0x03 0x00 0x00 0x00 ];
            }
            0x00000001: 
            {
                NAME: default, " Purchase cost"; // Default
                DESC: default, " Choose between cheaper or higher costs for buying trains."; // Default
                MASK: [ 0x01 ];
                LIMI: [ 0x00 0x00 0x00 0x00 0x04 0x00 0x00 0x00 ];
                VALU: 
                {
                    0x00000000: default, " very cheap"; // Default
                    0x00000001: default, " cheap"; // Default
                    0x00000002: default, " default"; // Default
                    0x00000003: default, " high"; // Default
                    0x00000004: default, " very high"; // Default
                }
                DFLT: [ 0x02 0x00 0x00 0x00 ];
            }
        }
        PALS: [ 0x44 ];
        BLTR: [ 0x33 ];
    }
}
