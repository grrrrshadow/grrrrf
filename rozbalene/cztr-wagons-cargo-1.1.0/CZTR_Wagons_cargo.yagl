// Record #3
strings<Trains, default, 0xD000*> // <feature, language, first_id> Action04, Default
{
    /* 0xD000 */ " {green}Dle data výroby";
    /* 0xD001 */ " {gold}4.ep {lt-gray}ČSD,{black} hnědý nátěr";
    /* 0xD002 */ " {gold}6.ep {lt-gray}ČD,{black} modrý nátěr";
    /* 0xD003 */ "Uae (ČSD)";
    /* 0xD004 */ "Eas (ČSD, ČD)";
    /* 0xD005 */ "Výrobce: {gold}Vagónka Poprad{black}{new-line}Vyrobené kusy: {gold}asi 12 tis. ks{lt-green}{new-line}Čtyřnápravový vůz určený pro přepravu hromadných a sypkých substrátů (kromě chemických), kusového a paletizovaného zboží, které při přepravě nevyžaduje krytý ložný prostor.";
    /* 0xD006 */ "Vsa (ČSD)";
    /* 0xD007 */ "Eal (ČSD)";
    /* 0xD008 */ "Výrobce: {gold}Vagónka Poprad{black}{new-line}Vyrobené kusy: {gold}nad 10 tis. ks{lt-green}{new-line}Čtyřnápravový vysokostěný univerzální vůz s čelními klapkami a 14 výsypnými podlahovými klapkami. Část vozů byla vybavena brzdařskou budkou.";
    /* 0xD009 */ "Vte (ČSD)";
    /* 0xD00A */ "Es (ČSD, ČD)";
    /* 0xD00B */ "Výrobce: {gold}Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}asi 12 tis. ks{lt-green}{new-line}Dvounápravový vysokostěnný vůz, navázal na dodávky podobných vozů z Jugoslávie a Rumunska.";
    /* 0xD00C */ " {gold}4.ep {lt-gray}ČSD,{black} hnědý nátěr";
    /* 0xD00D */ " {gold}5/6.ep {lt-gray}ČDC,{black} hnědý nátěr";
    /* 0xD00E */ " {gold}6.ep {lt-gray}Viamont,{black} žlutý nátěr";
    /* 0xD00F */ "Sas (ČSD)";
    /* 0xD010 */ "Faccs (ČSD, ČD, Private)";
    /* 0xD011 */ "Výrobce: {gold}Vagónka Poprad{black}{new-line}Vyrobené kusy: {gold}asi 5 150 ks{lt-green}{new-line}Čtyřnápravový výsypný vůz zvláštní stavby. Vůz umožňuje mechanizovanou nakládku a vykládku samospádem vně kolejí nebo mezi koleje. Vůz zkonstruovala vagónka Tatra Česká Lípa.";
    /* 0xD012 */ " {gold}4.ep {lt-gray}ČSD,{black} hnědý nátěr, špinavý od vápence";
    /* 0xD013 */ "Sasz (ČSD)";
    /* 0xD014 */ "Faccs krytý (ČSD ,ČD)";
    /* 0xD015 */ "Výrobce: {gold}Vagónka Poprad{black}{new-line}Vyrobené kusy: {gold}400 ks{lt-green}{new-line}Čtyřnápravový krytý výsypný vůz zvláštní stavby. Vůz umožňuje mechanizovanou nakládku a vykládku samospádem vně kolejí nebo mezi koleje. Kvůli orchraně před povětrnostními vlivy je vybaven posuvnou střechou. Vůz zkonstruovala vagónka Tatra Česká Lípa.";
    /* 0xD016 */ " {gold}4.ep {lt-gray}ČSD,{black} hnědý nátěr";
    /* 0xD017 */ " {gold}4.ep {lt-gray}ČSD,{black} šedý nátěr";
    /* 0xD018 */ " {gold}5/6.ep {lt-gray}ČDC,{black} hnědý nátěr";
    /* 0xD019 */ " {gold}6.ep {lt-gray}Českomoravský cement,{black} šedo-zelený nátěr";
    /* 0xD01A */ " {gold}6.ep {lt-gray}AWT,{black} tmavošedý nátěr";
    /* 0xD01B */ " {gold}5/6.ep {lt-gray}Viamont,{black} tmavošedý nátěr";
    /* 0xD01C */ "Wap (ČSD)";
    /* 0xD01D */ "Falls (ČSD, ČD, Private)";
    /* 0xD01E */ "Výrobce: {gold}Vagónka Poprad{black}{new-line}Vyrobené kusy: {gold}asi 8 tis. ks{lt-green}{new-line}Čtyřnápravový výsypný vůz zvláštní stavby. Koncepce vychází z německéh vozu OOt zkonstruovaného již v roce 1924";
    /* 0xD01F */ "Za (ČSD)";
    /* 0xD020 */ "Gags (ČSD,ČD)";
    /* 0xD021 */ "Výrobce: {gold}Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}asi 10 tis. ks{lt-green}{new-line}Čtyřnápravový krytý vůz běžné stavby určen pro přepravu různých druhů kusového baleného, paletizovaného, příp. i volně loženého zboží, které při přepravě vyžaduje ochranu před povětrnostními vlivy. Vůz je vybaven násypnými střešními otvory pro zrní.";
    /* 0xD022 */ "Výrobce: {gold}Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}asi 2 tis. ks{lt-green}{new-line}Dvounápravové vozy na přepravu spěšnin.";
    /* 0xD023 */ "Výrobce: {gold}Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}pod 1 000 ks{lt-green}{new-line}Dvounápravové vozy na přepravu spěšnin.";
    /* 0xD024 */ "Výrobce: {gold}Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}asi 4 tis. ks{lt-green}{new-line}Dvounápravové víceúčelové vozy. Jsou vybaeny násypnými střešními otvory pro zrní.";
    /* 0xD025 */ "Zav (ČSD)";
    /* 0xD026 */ "Hadgs (ČSD, ČD)";
    /* 0xD027 */ "Výrobce: {gold}Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}5619 ks{lt-green}{new-line}Krytý víceúčelový čtyřnápravový vůz s kovovou kostrou skříně s výplněmi vodovzdornou překližkou. Vozy byly vyráběny do roku 1976.";
    /* 0xD028 */ "Lpc (ČSD)";
    /* 0xD029 */ "Ibbhps (ČSD, ČD)";
    /* 0xD02A */ "Výrobce: {gold}VEB Waggonbau Niesky{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Chladící dvounápravový vůz pro přepravu potravin a piva. Výroba pro ČSD probíahal do roku 1975.";
    /* 0xD02B */ " {gold}1.ep {lt-gray}kkStB,{black} šedý nátěr";
    /* 0xD02C */ " {gold}2/3.ep {lt-gray}ČSD,{black} hnědý nátěr";
    /* 0xD02D */ "Kᵉ (kkStB, ČSD)";
    /* 0xD02E */ "U (ČSD)";
    /* 0xD02F */ "Výrobce: {gold}vagonky Ringhoffer, Česká Lípa, Kolín, Kopřivnice, Královo Pole, Studénka, Fryštát, Krompachy a Hlohovec{black}{new-line}Vyrobené kusy: {gold}asi 26 000 ks u ČSD{lt-green}{new-line}Dvounápravový vůz na uhlí a jiné substráty. Vyráběly se v mírně odlišných variantách až do roku 1923 a v provozu byly až do 60. let. 4 vozy byly pokusně vyrobeny z železobetonu.";
    /* 0xD030 */ " {gold}1/2.ep {lt-gray}ČSD,{black} bílý nátěr";
    /* 0xD031 */ " {gold}1/2.ep {lt-gray}Český akciový pivovar v Čes. Budějovicích,{black} krémový nátěr, červený nápis";
    /* 0xD032 */ " {gold}1/2.ep {lt-gray}Knížecí fürstenbergský parostrojní pivovar v Krušovících,{black}bílý nátěr s pruhy";
    /* 0xD033 */ " {gold}1/2.ep {lt-gray}Rolnický akciový pivovar v Litovli,{black} žlutý nátěr";
    /* 0xD034 */ " {gold}1/2.ep {lt-gray}Akciová společnost Moravia, pivovar a sladovna v Brně,{black} bílý nátěr, červený nápis";
    /* 0xD035 */ " {gold}1/2.ep {lt-gray}Prazdroj, měšťanský pivovar Plzeň,{black} bílý nátěr, zelený nápis";
    /* 0xD036 */ " {gold}1/2.ep {lt-gray}Plzeňské akciové pivovary Plzeň,{black} krémový nátěr, zelený nápis";
    /* 0xD037 */ " {gold}1/2.ep {lt-gray}První moravský pivovar akciový v Přerově,{black} bílý nátěr, modrý nátěr";
    /* 0xD038 */ " {gold}1/2.ep {lt-gray}Akcionářský pivovar na Smíchově {dq}Staropramen{dq},{black} krémový nátěr, zelený nápis";
    /* 0xD039 */ " {gold}1/2.ep {lt-gray}Pivovar Stein Bratislava,{black} bílý nátěr, červený nápis";
    /* 0xD03A */ " {gold}1/2.ep {lt-gray}Strassmann,{black} krémový nátěr, modrý nápis";
    /* 0xD03B */ "Gᵇ, Gᶠ, (kkStB, ČSD, Privat)";
    /* 0xD03C */ "Lp, (ČSD, Privat)";
    /* 0xD03D */ "Výrobce: {gold}Ringhofferovy závody, Vagónka Studénka, Vagonka Kopřivnice{black}{new-line}Vyrobené kusy: {gold}asi 1000 ks{lt-green}{new-line}Dvounápravový chladící vůz. Chlezení probíhalo prostředníctvím ledu, který musel být na větších stanicích doplňován. Nejčastěji se přepravovalo pivo, až později se rozšířila přeprava masa. Některé vozy byly vybaveny též závěsnými kamínky, které se používaly pro udržení teploty za velkých mrazů.";
    /* 0xD03E */ "M (ČSD)";
    /* 0xD03F */ "Hks (ČSD)";
    /* 0xD040 */ "Výrobce: {gold}Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}750 ks{lt-green}{new-line}Dvounápravový vůz pro přepravu živých zzvířat, konstrukčně vycházel z vozů Ztr.";
    /* 0xD041 */ "Výrobce: {gold}?{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Nákladní vozy Np vznikly přestavbou z poškozených vozů jiných řad u kterých byla oprava vozové skříně vyhodnocena jako neekonomická. Byly určeny pro přepravu zásilek do hmotnosti 17,5 tuny.";
    /* 0xD042 */ "Jd (ČSD)";
    /* 0xD043 */ "Ot (ČSD)";
    /* 0xD044 */ "Výrobce: {gold}Ringhofferovy závody{black}{new-line}Vyrobené kusy: {gold}100 ks{lt-green}{new-line}Oplenové vozy s malým rozvorem. Poslední byly vyřazeny v roce 1965.";
    /* 0xD045 */ "Výrobce spodku: {gold}Vagónka Tatra Smíchov, Vagónka Česká Lípa{black}{new-line}Výrobce tlakových nádob: {gold}ZVVZ Milevsko, Závody S. M. Kirova Levice{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Vůz Smmp nouzově upravený pro přepravu cementu z důvodů nedostatku vozů vhodných pro jeho velkoobjemové přepravy. Avšak v provozu tyto vozy vydržely krátce. Brzy byly nahrazeny masivními seriemi vozů Uacs/Raj.";
    /* 0xD046 */ " {gold}2.ep {lt-gray}ČSD,{black} šedý nátěr";
    /* 0xD047 */ " {gold}2.ep {lt-gray}ČSD,{black} šedý nátěr, hnědá budka";
    /* 0xD048 */ " {gold}1/2.ep {lt-gray}FANTO,{black} fialový nátěr, hnědá budka";
    /* 0xD049 */ " {gold}2.ep {lt-gray}M. Fischla synové, lihovar a rafinerie lihu, Zlíchov,{black} černý nátěr, hnědá budka";
    /* 0xD04A */ " {gold}2.ep {lt-gray}STAPRO (Státní prodejna báňských a hutních výrobků),{black} černý nátěr, hnědá budka";
    /* 0xD04B */ " {gold}1.ep {lt-gray}Kolínská rafinerie petroleje,{black} černý nátěr, hnědá budka";
    /* 0xD04C */ " {gold}1/2.ep {lt-gray}Vacuum oil company,{black} šedý nátěr";
    /* 0xD04D */ "Výrobce: {gold}Ringhofferovy závody, vagonka Kopřivnice{black}{new-line}Vyrobené kusy: {gold}přes 3000 ks{lt-green}{new-line}Cisternové vozy vyráběné v různých modifikacích objemu a materiálu kotle pro různé vlastníky.";
    /* 0xD04E */ "Pasy (ČSD)";
    /* 0xD04F */ "Sgs (ČSD, ČD)";
    /* 0xD050 */ "Výrobce: {gold}Čs.vagónky Tatra n.p. Studénka{black}{new-line}Vyrobené kusy: {gold}1239 ks{lt-green}{new-line}Plošinový vůz s klanicemi s kontejnerovou výbavou. Konstrukce spodku odpovídá vozům Res. Klanice byly později zrušeny.";
    /* 0xD051 */ "Výrobce: {gold}Vagónka Studénka{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Vůz na přepravu kontejnerů vyrábělný v letech 1996-2000.";
    /* 0xD052 */ "Výrobce: {gold}Tatra Vagonka Poprad{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Vůz na přepravu kontejnerů vyráběný od roku 2002.";
    /* 0xD053 */ " {gold}4.ep {lt-gray}ČSD,{black} černý nátěr";
    /* 0xD054 */ "Paj (ČSD)";
    /* 0xD055 */ "Sklmmp (ČSD)";
    /* 0xD056 */ "Výrobce: {gold}Vagónka Poprad{black}{new-line}Vyrobené kusy: {gold}4 ks{lt-green}{new-line}Speciální plošinový vůz pro převoz kyseliny fluorovodíkové využívaný ve sklárnách.";
    /* 0xD057 */ "Pao (ČSD)";
    /* 0xD058 */ "Smmp (ČSD, ČD)";
    /* 0xD059 */ "Výrobce: {gold}Vagónka Tatra Smíchov, Vagónka Česká Lípa{black}{new-line}Vyrobené kusy: {gold}asi 2170 ks{lt-green}{new-line}Plošinový vůz s menším rozvorem pro těžké náklady, například vojenskou techniku.";
    /* 0xD05A */ " {gold}2/3.ep {lt-gray}ČSD,{black} hnědý nátěr";
    /* 0xD05B */ " {gold}2/3.ep {lt-gray}ČSD,{black} šedý nátěr";
    /* 0xD05C */ "Výrobce: {gold}Talbot{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Výsypné vozy vyráběné pro DR, do Československa se dostaly po druhé světové válce.";
    /* 0xD05D */ " {gold}5/6.ep {lt-gray}Zeocem,{black} zeleno-bílý nátěr";
    /* 0xD05E */ "Raj (ČD)";
    /* 0xD05F */ "Uacs (ČSD, ČD, Private)";
    /* 0xD060 */ "Výrobce spodku: {gold}Vagónka Poprad{black}{new-line}Výrobce tlakových nádob: {gold}ZVVZ Milevsko{black}{new-line}Vyrobené kusy: {gold}asi 2050 ks{lt-green}{new-line}Vzhledem k poválečnému nárůstu potřeby přepravy cementu a jiných práškových hmot bylo nutné zkonstruovat vozy které by umožnily jejich přepravu bez nutnosti složitého překládání. Na provizorně upravené vozy Paoj a Zzv navázala řada Raj se čtyřmi komorovými podavači. Různé série se lišily konstrukcí spodku vozu. Vozy byly zpravidla ve vlastnictví různých cementáren a jiných podniků.";
    /* 0xD061 */ "Vut (ČSD)";
    /* 0xD062 */ "Vtu (ČSD)";
    /* 0xD063 */ "El (ČSD)";
    /* 0xD064 */ "Výrobce: {gold}vagonky Dessau, Görlitz, Hannover, Uerdingen, Niesky, Busch Bautzen, Brmen, Linke Hoffman Breslau, Killing & Sohn Hagen, Ammendorf, Lüttgens, Mechernich, Oldenburg, Rastatt, Talbot Aachen, Werdau, Wismar, Goosens, Zwickau, Königshütte, O & K Spandau, Rheinische Maschinenfabrik Düsseldorf, Siegen-Weidenau{black}{new-line}Vyrobené kusy: {gold}asi 3 747 ks u ČSD{lt-green}{new-line}Dvounápravové vozy německé konstrukce dodané v roce 1920. ČSD je výhodně koupily přes firmu Arnos & Walter. Asi 1 400 vozů zakoupila též Akciová společnost pro půjčování vozů. Poté co v roce 1928 přešly tyto vozy též do vlastnictví ČSD.";
    /* 0xD065 */ "Vtr (ČSD)";
    /* 0xD066 */ "E (ČSD)";
    /* 0xD067 */ "Výrobce: {gold}vagonky Česká Lípa, Kolín, Kopřivnice, Královo Pole, Smíchov a Studénka{black}{new-line}Vyrobené kusy: {gold}přes 15 000 ks{lt-green}{new-line}Otevřené vozy vyráběné v letech 1947 až 1957, pro poválečnou obnovu nákladního vozového parku ČSD. Konstrukce podvozku byla shodná s vozy Ztr, některé vozy byly nebržděné, některé byly vybaveny brzdařskou budkou. Většina byla vyřazeny v 90. letech.{black}{new-line}Autor modelu: {gold}Pikku";
    /* 0xD068 */ " {gold}3/4.ep {lt-gray}ČSD,{black} světle šedá";
    /* 0xD069 */ " {gold}3/4.ep {lt-gray}ČSD,{black} šedá";
    /* 0xD06A */ " {gold}4.ep {lt-gray}ČSD,{black} hnědá";
    /* 0xD06B */ " {gold}5/6.ep {lt-gray}OKD,{black} hnědá";
    /* 0xD06C */ "Wa/Wap (ČSD)";
    /* 0xD06D */ "Fall (ČSD, Private)";
    /* 0xD06E */ "Výrobce: {gold}Čs.vagónky Tatra, Studénka{black}{new-line}Vyrobené kusy: {gold}asi 4 tis. ks{lt-green}{new-line}Čtyřnápravový výsypný vůz zvláštní stavby. Koncepce vychází z německéh vozu OOt zkonstruovaného již v roce 1924";
    /* 0xD06F */ " {gold}5/6.ep {lt-gray}ZSSK,{black} černý nátěr";
    /* 0xD070 */ " {gold}5.ep {lt-gray}ČD,{black} zelený nátěr";
    /* 0xD071 */ "Rahi (ČSD)";
    /* 0xD072 */ "Zaes (ČSD, ČD)";
    /* 0xD073 */ "Výrobce: {gold}Vagónka Studénka{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Čtyřnápravový vůz dodávaný zejména ČSD, s ocelovým kotlem s parním vytápěním a oplášťováním, unifikované konstrukce s jednotným žebřinovým rámem. Kotel s gravitačním vykládáním spodním T-potrubím s možností vyložení na obě strany. Některé z vozů měly antikorozní kotle vyrobené KPS.";
    /* 0xD074 */ " {gold}5/6.ep {lt-gray}GATX,{black} šedý nátěr";
    /* 0xD075 */ " {gold}5/6.ep {lt-gray}KGV,{black} šedý nátěr";
    /* 0xD076 */ " {gold}5.ep {lt-gray}KGV,{black} světle zelený nátěr";
    /* 0xD077 */ " {gold}6.ep {lt-gray}WASCOSA,{black} modrý nátěr";
    /* 0xD078 */ "Výrobce: {gold}ASTRA Vagoane Arad S.A{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Cisternový vůz na lehké látky vyráběný od roku 2002";
    /* 0xD079 */ "Výrobce: {gold}?{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Od roku 1966 vyráběn v Maďarských vagonkách a strojírnách RÁBA Győr";
    /* 0xD07A */ "Gᵍ (kkStB, ČSD)";
    /* 0xD07B */ "Z (ČSD)";
    /* 0xD07C */ "Výrobce: {gold}vagonky Ringhoffer, Česká Lípa, Kolín, Kopřivnice, Královo Pole, Studénka a Kistarcsa u Budapešti.{black}{new-line}Vyrobené kusy: {gold}asi 30 000 ks u ČSD{lt-green}{new-line}Dvounápravový zavřený vůz. Část vozů převzaly Československé státní dráhy od kkStB a MÁV, další se vyráběly až do roku 1923 a v provozu byly až do 70. let.";
    /* 0xD07D */ "Ztr (ČSD)";
    /* 0xD07E */ "Glm (ČSD)";
    /* 0xD07F */ "Výrobce: {gold}vagonky Česká Lípa, Kolín, Kopřivnice, Královo Pole, Smíchov a Studénka{black}{new-line}Vyrobené kusy: {gold}přes 15 000 ks{lt-green}{new-line}Typizované kryté vozy vyráběné v letech 1946 až 1948, konstrukce podvozku byla shodná s vozy Vtr. Byly vyráběny též různé varianty pro specifické druhy zboží. Něktré vozy byly vybaveny brzdařskou budkou, nebo byly nebržděné, většina měla tlakovou brzdu. Byly exportovány do Západního Německa, Nizozemí a Turecka. Z provozu byly vyřazovány v 90. letech.{black}{new-line}Autor modelu: {gold}Pikku";
    /* 0xD080 */ "Výrobce: {gold}Ostravské opravny a strojírny{black}{new-line}Vyrobené kusy: {gold}300 ks{lt-green}{new-line}Rekonstrukce z vozů Res.";
    /* 0xD081 */ "Výrobce: {gold}Ostravské opravny a strojírny{black}{new-line}Vyrobené kusy: {gold}100 dvouvozových jednotek{lt-green}{new-line}Rekonstrukce z vozu Gbgkks. Z původních vozů byl využit pouze spodek vozu, ma který po zesílení byla postavena pevná čela, klanice a upevňovací prvky pro přepravu zejména dřevěné kulatiny. Vždy dva vozy jsou na pevno spřaženy do jednotky.";
    /* 0xD082 */ "Nas (ČSD)";
    /* 0xD083 */ "Res (ČSD, ČD)";
    /* 0xD084 */ "Výrobce: {gold}Vagónka Poprad{black}{new-line}Vyrobené kusy: {gold}asi 3445 ks{lt-green}{new-line}Čtyřnápravový nízkostěnný vůz s klanicemi a sklopnými bočnicemi a čelnicemi.";
    /* 0xD085 */ "Ra (ČSD)";
    /* 0xD086 */ "Zae (ČSD)";
    /* 0xD087 */ "Výrobce: {gold}Vagónka Kopřivnice, Královopolská strojírna{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Čtyřnápravový cisternový vůz německé konstrukce vyráběný v průběhu války a krátce po ní i na území Československa. ČSD se obávaly samonosné konstrukce a vozy byly proto prodány soukromým podnikům.";
    /* 0xD088 */ "R (ČSD, Private)";
    /* 0xD089 */ "Zek (ČSD, ČD, Private)";
    /* 0xD08A */ "Výrobce: {gold}Vagónka Studénka, Královopolská strojírna{black}{new-line}Vyrobené kusy: {gold}? ks{lt-green}{new-line}Cisternové vozy na jednotném podovzku, vyráběné s objemem 110 až 300 hl čemuž odpovídal průměr kotle 1 500 až 2 500 mm.  Do roku 1967 byly vyrobeny v 57 různých varantách dle objemu a materiálu kotle a vnitřího obložení pro různé účely.";
}
