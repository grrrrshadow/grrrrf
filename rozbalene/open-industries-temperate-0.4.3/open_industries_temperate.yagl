yagl_version: "";
grf_format: Container2;
// Record #1
optional_info // Action14
{
    INFO: 
    {
        DESC: de_DE, "Eine vollständige gemäßigte Wirtschaft mit 28 Frachtarten, 28 Industrien, Lagerrezepten, Lieferboni, bedienungsabhängiger Produktion, originalen Industrieanlagen und eigenen 8bpp-Grafiken. Benötigt OpenTTD 15.3 oder neuer. Nicht mit anderen Industrie-Ersatzsets kombinieren."; // German
        VRSN: [ 0xC8 0x00 0x00 0x00 ];
        MINV: [ 0x64 0x00 0x00 0x00 ];
        NPAR: [ 0x01 ];
        PARA: 
        {
            0x00000000: 
            {
                NAME: default, "Automatic town-encroachment clearance"; // Default
                NAME: de_DE, "Automatische Räumung bei Stadtausbreitung"; // German
                DESC: default, "When enabled, a rural primary industry inside the inner suburbs or town centre announces closure if at least one other industry of that type remains. Disabled by default."; // Default
                DESC: de_DE, "Wenn aktiviert, kündigt ein ländlicher Primärbetrieb in inneren Vororten oder im Stadtzentrum seine Schließung an, sofern mindestens ein weiterer Betrieb dieses Typs bestehen bleibt. Standardmäßig deaktiviert."; // German
                TYPE: [ 0x01 ];
                MASK: [ 0x00 0x00 0x01 ];
                DFLT: [ 0x00 0x00 0x00 0x00 ];
            }
        }
        PALS: [ 0x44 ];
        BLTR: [ 0x38 ];
    }
}
// Record #2
grf // Action08
{
    grf_id: "OIT1";
    version: GRF8;
    name: "Open Industries: Temperate 0.4.3";
    description: "A complete Temperate economy with 28 cargoes, 28 industries, stockpiled recipes, supply bonuses, service-driven production, original industry layouts and custom 8bpp artwork. Requires OpenTTD 15.3 or newer. Do not combine with another industry replacement set.";
}
