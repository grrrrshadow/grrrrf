yagl_version: "";
grf_format: Container2;

// ====================================================================
// shuttletest.grf  -- DIAGNOSTICKY BUILD, ne na hrani
// ====================================================================
// Prepinac dava cumak NAHORU vsem pozemnim stavum 0-11 (hangar,
// pojizdeni, terminaly). Slouzilo to k overeni, ze se prepinac na 0xE2
// vubec vyhodnocuje.
//
// OVERENO VE HRE: zvedá cumak pri pojizdeni u terminalu, tedy prepinac
// funguje. (Prvni pokus se neprojevil proto, ze se GRF kopirovalo do
// adresare jineho, starsiho OpenTTD -- ne kvuli obsahu souboru.)
// ====================================================================

grf // Action08
{
    grf_id: "GRST";
    version: GRF8;
    name: "shuttletest";
    description: "{orange}Shuttle{new-line}{black}Zkusebni letadlo, ctyri faze letu.{new-line}Licence: GPL v2";
}

