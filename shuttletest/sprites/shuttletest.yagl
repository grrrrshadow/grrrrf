sprite_groups<Aircraft, 0x00F0> // Action02 basic - rovne
{
    primary_spritesets: [ 0x0000 ];
    secondary_spritesets: [ 0x0000 ];
}

sprite_groups<Aircraft, 0x00F1> // Action02 basic - rozjezd
{
    primary_spritesets: [ 0x0001 ];
    secondary_spritesets: [ 0x0001 ];
}

sprite_groups<Aircraft, 0x00F2> // Action02 basic - stoupani
{
    primary_spritesets: [ 0x0002 ];
    secondary_spritesets: [ 0x0002 ];
}

sprite_groups<Aircraft, 0x00F3> // Action02 basic - klesani
{
    primary_spritesets: [ 0x0003 ];
    secondary_spritesets: [ 0x0003 ];
}

switch<Aircraft, 0x00FF, PrimaryDWord> // Action02 variable - faze letu
{
    expression:
    {
        value1 = variable[0xE2] & 0x000000FF;
    };
    ranges:
    {
        // DIAGNOSTIKA: vsechny pozemni stavy dostanou cumak NAHORU.
        // Stani u terminalu a pojizdeni trva dlouho a je to videt hned.
        // Kdyz stojici letadlo NEMA cumak nahoru, prepinac se vubec
        // nevyhodnocuje a chyba je jinde nez v cislech stavu.
        0x00000000..0x0000000B: 0x00F2;   // hangar, pojizdeni, terminaly
    };
    default: 0x00F0;                      // let = rovne
}

properties<Aircraft, 0x0029> // Action00
{
    // instance_id: 0x0029
    {
        sprite_id: 0xFF;
        is_helicopter: false;
        is_large: false;
        climate_availability: Temperate | Arctic | Tropical | Toyland;
        long_introduction_date: date(2042/1/1);
        model_life_years: 0xFF;
        vehicle_life_years: 30;
        reliability_decay_speed: 20;
        cost_factor: 0x20;
        running_cost_factor: 0x50;
        speed_8_mph: 0x28;
        acceleration: 0x20;
        passenger_capacity: 0x0050;
        mail_capacity: 0x14;
        loading_speed: 0x0A;
        sound_effect_type: 0x3D;
        miscellaneous_flags: 0x02;
        aircraft_range: 0x0000;
    }
}

