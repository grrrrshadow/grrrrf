+/* ZKOUSKA V3S (jen tahle kopie hry): postavi silnicni depo, koupi kazde kupovatelne silnicni vozidlo
+ * z GRF TEST_RV_GRF, prestavi ho na nekolik nakladu a vypise clanky, delky, kapacity a sprite. */
+static bool ConTestV3S(std::span<std::string_view> argv)
+{
+	if (argv.empty()) {
+		IConsolePrint(CC_HELP, "Zkouska silnicnich vozidel z GRF TEST_RV_GRF. Usage: 'testv3s'.");
+		return true;
+	}
+	if (_game_mode != GameMode::Normal) return true;
+	if (Company::GetIfValid(_local_company) == nullptr) {
+		extern Company *DoStartupNewCompany(bool is_ai, CompanyID company);
+		Company *made = DoStartupNewCompany(false, CompanyID::Invalid());
+		if (made == nullptr) return true;
+		SetLocalCompany(made->index);
+	}
+	Command<Commands::MoneyCheat>::Do(DoCommandFlag::Execute, 100000000);
+	const char *want_s = getenv("TEST_RV_GRF");
+	if (want_s == nullptr || strlen(want_s) != 4) {
+		IConsolePrint(CC_ERROR, "V3S: chybi TEST_RV_GRF");
+		return true;
+	}
+	uint32_t want = (uint8_t)want_s[0] | (uint8_t)want_s[1] << 8 | (uint8_t)want_s[2] << 16 | (uint32_t)(uint8_t)want_s[3] << 24;
+	TileIndex depot = INVALID_TILE;
+	for (uint y = 8; y < Map::SizeY() - 8 && depot == INVALID_TILE; y++) {
+		for (uint x = 8; x < Map::SizeX() - 8; x++) {
+			TileIndex t = TileXY(x, y);
+			if ((IsTileType(t, TileType::Clear) || IsTileType(t, TileType::Trees)) && GetTileSlope(t) == SLOPE_FLAT) {
+				depot = t;
+				break;
+			}
+		}
+	}
+	CommandCost dc = Command<Commands::BuildRoadDepot>::Do(DoCommandFlag::Execute, depot, ROADTYPE_ROAD, DiagDirection::SW);
+	IConsolePrint(CC_INFO, "V3S: depo {} {}", depot.base(), dc.Succeeded() ? "ok" : "CHYBA");
+	static const char *const labels[] = {"GOOD", "PASS", "MAIL", "STEL", "COAL", "IORE", "LVST", "WOOD", "GRAI", "VALU", "SAND", "MARI", "TATO", "CMNT", "GRVL", "TOUR", "BEER", "FICR", "CHEM", "TOYS", "URAN", "WATR", "ACID", "OIL_", "JAVA", "CLAY", "SGCN", "KAOL", "BRCK", "BDMT", "FRUT", "STUD", "WINE", "HOPS"};
+	for (const Engine *e : Engine::IterateType(VehicleType::Road)) {
+		if (e->GetGRFID() != want) continue;
+		IConsolePrint(CC_INFO, "V3S: engine {} local 0x{:04X} poradi v nakupu {} dostupny {} naklady {} kapacita {}", e->index.base(), e->grf_prop.local_id,
+				e->list_position, e->company_avail.Test(_local_company) ? 1 : 0, e->info.refit_mask.Count(), e->GetDisplayDefaultCapacity());
+		{
+			/* jako okno nakupu (vehicle_gui.cpp, ShowRefitOptionsList): do 7 chybejicich pise "vse krome" */
+			CargoTypes umi = GetUnionOfArticulatedRefitMasks(e->index, false);
+			CargoTypes chybi = CargoTypes{umi}.Flip(_cargo_mask);
+			std::string seznam;
+			for (CargoType c : chybi) seznam += fmt::format(" {}", CargoSpec::Get(c)->label.base() == 0 ? std::string("?") :
+					fmt::format("{:c}{:c}{:c}{:c}", (char)(CargoSpec::Get(c)->label.base() >> 24), (char)(CargoSpec::Get(c)->label.base() >> 16 & 0xFF), (char)(CargoSpec::Get(c)->label.base() >> 8 & 0xFF), (char)(CargoSpec::Get(c)->label.base() & 0xFF)));
+			IConsolePrint(CC_INFO, "V3S:   nakup: umi {} z {}, chybi {}:{} -> {}", umi.Count(), _cargo_mask.Count(), chybi.Count(), seznam,
+					umi == _cargo_mask ? "vse" : (chybi.Count() <= 7 && chybi.Count() < umi.Count() ? "kratce vse krome" : "dlouhy seznam"));
+		}
+		if (!e->company_avail.Test(_local_company)) continue;
+		auto [bc, vid, bcap, bmail, bcaps] = Command<Commands::BuildVehicle>::Do(DoCommandFlag::Execute, depot, e->index, true, INVALID_CARGO, ClientID::Invalid);
+		if (bc.Failed() || Vehicle::GetIfValid(vid) == nullptr) {
+			IConsolePrint(CC_ERROR, "V3S: koupe selhala");
+			continue;
+		}
+		for (const char *lab : labels) {
+			uint32_t l = (uint32_t)(uint8_t)lab[0] << 24 | (uint8_t)lab[1] << 16 | (uint8_t)lab[2] << 8 | (uint8_t)lab[3];
+			CargoType ct = GetCargoTypeByLabel(CargoLabel{l});
+			if (!IsValidCargoType(ct)) {
+				IConsolePrint(CC_INFO, "V3S:   {} ve hre neni", lab);
+				continue;
+			}
+			auto [rc, rcap, rmail, rcaps] = Command<Commands::RefitVehicle>::Do(DoCommandFlag::Execute, vid, ct, 0, false, false, 0);
+			std::string radek;
+			for (const RoadVehicle *u = RoadVehicle::From(Vehicle::Get(vid)); u != nullptr; u = u->Next()) {
+				VehicleSpriteSeq seq;
+				u->GetImage(Direction::W, EngineImageType::OnMap, &seq);
+				VehicleSpriteSeq seq_ne;
+				u->GetImage(Direction::NE, EngineImageType::OnMap, &seq_ne);
+				radek += fmt::format(" | dil 0x{:04X} delka {} kapacita {} sprite W {} NE {}", Engine::Get(u->engine_type)->grf_prop.local_id,
+						u->gcache.cached_veh_length, u->cargo_cap, seq.count > 0 ? seq.seq[0].sprite : 0, seq_ne.count > 0 ? seq_ne.seq[0].sprite : 0);
+			}
+			bool prestaveno = rc.Succeeded() && Vehicle::Get(vid)->Last()->cargo_type == ct;
+			IConsolePrint(CC_INFO, "V3S:   {} prestavba {}{}", lab, prestaveno ? "ok" : "NE (nevozi)", radek);
+			if (prestaveno) {
+				/* nalozit plne a znovu se podivat na sprite (kupka nebo plachta), pak zase vylozit */
+				std::string plne;
+				for (RoadVehicle *u = RoadVehicle::From(Vehicle::Get(vid)); u != nullptr; u = u->Next()) {
+					if (u->cargo_cap > 0 && CargoPacket::CanAllocateItem()) u->cargo.Append(CargoPacket::Create(StationID::Invalid(), u->cargo_cap, Source{}));
+					VehicleSpriteSeq seq;
+					u->GetImage(Direction::W, EngineImageType::OnMap, &seq);
+					std::string vrstvy;
+					for (uint s = 0; s < seq.count; s++) vrstvy += fmt::format("{}{}", s == 0 ? "" : "+", seq.seq[s].sprite);
+					plne += fmt::format(" | dil 0x{:04X} nalozeno {} sprite W {} (vrstev {})", Engine::Get(u->engine_type)->grf_prop.local_id, u->cargo.StoredCount(), vrstvy, seq.count);
+					u->cargo.Truncate();
+				}
+				IConsolePrint(CC_INFO, "V3S:   {} plne{}", lab, plne);
+			}
+			static const std::string_view s_podtypy[] = {"LVST", "FICR", "BEER", "BRCK", "BDMT", "TATO"};
+			if (std::find(std::begin(s_podtypy), std::end(s_podtypy), std::string_view(lab)) != std::end(s_podtypy) && rc.Succeeded()) {
+				/* naklady s podtypy (callback 0x19): jmeno za nakladem a vrstvy obrazku pro kazdy podtyp */
+				for (uint8_t podtyp = 0; podtyp < 4; podtyp++) {
+					auto [pc, pcap, pmail, pcaps] = Command<Commands::RefitVehicle>::Do(DoCommandFlag::Execute, vid, ct, podtyp, false, false, 0);
+					std::string radek2;
+					for (RoadVehicle *u = RoadVehicle::From(Vehicle::Get(vid)); u != nullptr; u = u->Next()) {
+						if (u->cargo_cap > 0 && CargoPacket::CanAllocateItem()) u->cargo.Append(CargoPacket::Create(StationID::Invalid(), u->cargo_cap, Source{}));
+						VehicleSpriteSeq seq;
+						u->GetImage(Direction::W, EngineImageType::OnMap, &seq);
+						std::string vrstvy;
+						for (uint s = 0; s < seq.count; s++) vrstvy += fmt::format("{}{}", s == 0 ? "" : "+", seq.seq[s].sprite);
+						StringID jm = GetCargoSubtypeText(u);
+						radek2 += fmt::format(" | dil 0x{:04X} podtyp {} jmeno '{}' sprite W {}", Engine::Get(u->engine_type)->grf_prop.local_id,
+								u->cargo_subtype, jm == STR_EMPTY ? std::string("-") : GetString(jm), vrstvy);
+						u->cargo.Truncate();
+					}
+					IConsolePrint(CC_INFO, "V3S:   {} podtyp {} prestavba {}{}", lab, podtyp, pc.Succeeded() ? "ok" : "NE", radek2);
+				}
+				Command<Commands::RefitVehicle>::Do(DoCommandFlag::Execute, vid, ct, 0, false, false, 0);
+			}
+		}
+		/* zvuky (callback 0x33): odjezd v depu (auto schovane) a venku, jizda v ruznych rychlostech, stani;
+		 * brana pousti kousek jen v prvnich 16 ticich z kazdych 112, tak se citac tiku na chvili posune */
+		if (e->info.callback_mask.Test(VehicleCallbackMask::SoundEffect)) {
+			RoadVehicle *rv = RoadVehicle::From(Vehicle::Get(vid));
+			auto puvodni = TimerGameTick::counter;
+			TimerGameTick::counter -= (TimerGameTick::counter & 0xFFFF) % 112;
+			auto zvuk = [&](int ud) { return GetVehicleCallback(CBID_VEHICLE_SOUND_EFFECT, ud, 0, rv->engine_type, rv); };
+			std::string z = fmt::format("depo {:#x}", zvuk(1));
+			bool schovane = rv->vehstatus.Test(VehState::Hidden);
+			rv->vehstatus.Reset(VehState::Hidden);
+			z += fmt::format(" zastavka {:#x}", zvuk(1));
+			if (schovane) rv->vehstatus.Set(VehState::Hidden);
+			for (int kmh : {0, 10, 20, 35, 50, 60}) {
+				rv->cur_speed = kmh * 2;
+				z += fmt::format(" jizda{} {:#x}", kmh, zvuk(7));
+			}
+			rv->cur_speed = 0;
+			z += fmt::format(" stani {:#x} porucha {:#x}", zvuk(8), zvuk(3));
+			TimerGameTick::counter += 20;
+			z += fmt::format(" | mimo branu jizda {:#x} stani {:#x}", zvuk(7), zvuk(8));
+			TimerGameTick::counter = puvodni;
+			IConsolePrint(CC_INFO, "V3S:   zvuky (schovane v depu {}) {}", schovane ? 1 : 0, z);
+		}
+	}
+	return true;
+}
+
+
+/* ZKOUSKA V3S, fotka (jen tahle kopie hry): silnicni okruh s depem, V3S z GRF v TEST_RV_GRFS (MAXd,MAXe),
+ * modre prestavene na ruzne naklady, nechat jezdit a vyfotit priblizene (screenshot SC_ZOOMEDIN). */
+/* vypis zkousky V3S do konzole i na stderr (s obrazem jde konzole jen do okna) */
+template <typename... T>
+static void V3SLog(fmt::format_string<T...> f, T &&... args)
+{
+	std::string s = fmt::format(f, std::forward<T>(args)...);
+	IConsolePrint(CC_INFO, s);
+	Debug(misc, 0, "{}", s);
+}
+
+static TileIndex _v3s_stred = INVALID_TILE;
+/* fotky: kolik jeste, po kolika ticich, cislo dalsi a tik dalsi (hodiny tikaji porad, fotka jen kdyz je co fotit) */
+static uint _v3s_foto_zbyva = 0, _v3s_foto_krok = 100, _v3s_foto_cislo = 0, _v3s_foto_pocet = 1;
+static TimerGameTick::TickCounter _v3s_foto_dalsi = 0;
+/** Fotka okruhu az hra opravdu bezi (hned po zalozeni hry se jeste netika); po posledni konec hry.
+ * Poloha kazdeho dilu a pocatek pohledu se vypisou ve fronte hlavniho vlakna hned za fotkou, mezi nimi hra netika. */
+static void V3SFotoTed()
+{
+	uint cislo = _v3s_foto_cislo++;
+	std::string jmeno = _v3s_foto_pocet == 1 ? std::string("v3s_okruh") : fmt::format("v3s_okruh_{:02}", cislo);
+	bool foto = MakeScreenshot(SC_ZOOMEDIN, jmeno);
+	V3SLog("V3SFOTO: fotka {} {}", jmeno, foto ? "ok" : "CHYBA");
+	VideoDriver::GetInstance()->QueueOnMainThread([cislo] {
+		const Viewport &vp = *GetMainWindow()->viewport;
+		V3SLog("V3SPOHLED: fotka {} vlevo {} nahore {}", cislo, vp.virtual_left, vp.virtual_top);
+		for (const RoadVehicle *v : RoadVehicle::Iterate()) {
+			const Engine *e = v->GetEngine();
+			uint32_t g = e->GetGRFID();
+			std::string grf = e->GetGRF() == nullptr ? std::string("hra") : fmt::format("{:c}{:c}{:c}{:c}", (char)(g & 0xFF), (char)(g >> 8 & 0xFF), (char)(g >> 16 & 0xFF), (char)(g >> 24));
+			V3SLog("V3SDIL: fotka {} vuz {} grf {} dil 0x{:04X} x {} y {} z {} smer {} stav {:02X} delka {} kresli {} {}", cislo, v->First()->unitnumber, grf,
+					e->grf_prop.local_id, v->x_pos, v->y_pos, v->z_pos, to_underlying(v->direction), v->state, v->gcache.cached_veh_length,
+					v->bounds.origin.x + v->bounds.offset.x, v->bounds.origin.y + v->bounds.offset.y);
+		}
+	});
+	if (--_v3s_foto_zbyva == 0) {
+		for (const RoadVehicle *v : RoadVehicle::Iterate()) {
+			if (!v->IsFrontEngine()) continue;
+			V3SLog("V3SFOTO: vuz {} dlazdice ({},{}) smer {} stav {:02X}", v->unitnumber, TileX(v->tile), TileY(v->tile), to_underlying(v->direction), v->state);
+		}
+		/* fotka se dela az ve fronte hlavniho vlakna, konec hry az po ni */
+		VideoDriver::GetInstance()->QueueOnMainThread([] { _exit_game = true; });
+	}
+}
+static IntervalTimer<TimerGameTick> _v3s_foto_hodiny({ TimerGameTick::Priority::None, 1 }, [](auto) {
+	if (_v3s_foto_zbyva == 0 || TimerGameTick::counter < _v3s_foto_dalsi) return;
+	_v3s_foto_dalsi = TimerGameTick::counter + _v3s_foto_krok;
+	V3SFotoTed();
+});
+
+static bool ConTestV3SFoto(std::span<std::string_view> argv)
+{
+	if (argv.empty()) {
+		IConsolePrint(CC_HELP, "Fotka V3S na okruhu. Usage: 'testv3sfoto <tiku> [RTxx] [fotek] [tiku mezi fotkami]'.");
+		return true;
+	}
+	if (_game_mode != GameMode::Normal) return true;
+	if (Company::GetIfValid(_local_company) == nullptr) {
+		extern Company *DoStartupNewCompany(bool is_ai, CompanyID company);
+		Company *made = DoStartupNewCompany(false, CompanyID::Invalid());
+		if (made == nullptr) return true;
+		SetLocalCompany(made->index);
+	}
+	Command<Commands::MoneyCheat>::Do(DoCommandFlag::Execute, 100000000);
+	uint tiku = 400;
+	if (argv.size() > 1) {
+		tiku = 0;
+		for (char c : argv[1]) if (c >= '0' && c <= '9') tiku = tiku * 10 + (c - '0');
+	}
+	/* rovne prazdne misto 14 x 10 dlazdic */
+	const uint W = 14, H = 10;
+	TileIndex zac = INVALID_TILE;
+	for (uint y = 10; y + H < Map::SizeY() - 10 && zac == INVALID_TILE; y++) {
+		for (uint x = 10; x + W < Map::SizeX() - 10; x++) {
+			bool ok = true;
+			int z0 = GetTileZ(TileXY(x, y));
+			for (uint dy = 0; dy < H && ok; dy++) for (uint dx = 0; dx < W && ok; dx++) {
+				TileIndex t = TileXY(x + dx, y + dy);
+				ok = (IsTileType(t, TileType::Clear) || IsTileType(t, TileType::Trees)) && GetTileSlope(t) == SLOPE_FLAT && GetTileZ(t) == z0;
+			}
+			if (ok) { zac = TileXY(x, y); break; }
+		}
+	}
+	if (zac == INVALID_TILE) {
+		V3SLog("V3SFOTO: neni misto");
+		return true;
+	}
+	uint x0 = TileX(zac) + 1, y0 = TileY(zac) + 2, x1 = x0 + 11, y1 = y0 + 6;
+	/* silnice: CZTR 1. trida venkov (RT14), kdyz je nactena (hra/cztr_silnice), jinak bezna */
+	/* druhy argument: stitek typu silnice (napr. RT06), jinak RT14, kdyz je nactena */
+	std::string stitek = argv.size() > 2 ? std::string(argv[2]) : std::string("RT14");
+	RoadType rt = INVALID_ROADTYPE;
+	if (stitek.size() == 4) rt = GetRoadTypeByLabel((uint32_t)(uint8_t)stitek[0] << 24 | (uint8_t)stitek[1] << 16 | (uint8_t)stitek[2] << 8 | (uint8_t)stitek[3], false);
+	if (rt == INVALID_ROADTYPE) rt = ROADTYPE_ROAD;
+	V3SLog("V3SFOTO: silnice {} (typ {})", rt == ROADTYPE_ROAD ? "bezna ROAD" : stitek, to_underlying(rt));
+	auto usek = [rt](TileIndex a, TileIndex b, Axis ax) {
+		return Command<Commands::BuildRoadLong>::Do(DoCommandFlag::Execute, b, a, rt, ax, DisallowedRoadDirections{}, true, true, false).Succeeded();
+	};
+	bool ok = usek(TileXY(x0, y0), TileXY(x1, y0), Axis::X) && usek(TileXY(x0, y1), TileXY(x1, y1), Axis::X) &&
+			usek(TileXY(x0, y0), TileXY(x0, y1), Axis::Y) && usek(TileXY(x1, y0), TileXY(x1, y1), Axis::Y);
+	TileIndex depot = TileXY(x0 + 5, y0 - 1);
+	ok = ok && Command<Commands::BuildRoad>::Do(DoCommandFlag::Execute, TileXY(x0 + 5, y0), RoadBits{RoadBit::NW}, rt, DisallowedRoadDirections{}, TownID::Invalid()).Succeeded();
+	ok = ok && Command<Commands::BuildRoadDepot>::Do(DoCommandFlag::Execute, depot, rt, DiagDirection::SE).Succeeded();
+	V3SLog("V3SFOTO: okruh ({},{})-({},{}) depo {}", x0, y0, x1, y1, ok ? "ok" : "CHYBA");
+	/* co koupit: grf, mistni cislo, naklad (prazdny = vychozi) */
+	struct Nakup { const char *grf; uint16_t local; const char *naklad; bool plne; uint8_t podtyp = 0; };
+	static const Nakup nakupy[] = {
+		{"MAXe", 0x0101, "BRCK", true, 0}, {"MAXe", 0x0100, "BRCK", true, 1}, {"MAXe", 0x0101, "FRUT", true}, {"MAXe", 0x0100, "TATO", true, 0},
+		{"MAXd", 0x0101, "TATO", true, 1}, {"MAXd", 0x0100, "FRUT", true}, {"MAXd", 0x0101, "BEER", true, 1}, {"MAXd", 0x0100, "BEER", true, 2},
+		{"MAXd", 0x0101, "BDMT", true, 1}, {"MAXe", 0x0100, "HOPS", true},
+	};
+	/* pro srovnani pruhu dva puvodni nakladaky hry (bez NewGRF) */
+	int puvodnich = 0;
+	for (const Engine *e : Engine::IterateType(VehicleType::Road)) {
+		if (puvodnich >= 2) break;
+		if (e->GetGRF() != nullptr || !e->company_avail.Test(_local_company)) continue;
+		if (IsCargoInClass(e->GetDefaultCargoType(), CargoClass::Passengers)) continue;
+		auto [bc, vid, bcap, bmail, bcaps] = Command<Commands::BuildVehicle>::Do(DoCommandFlag::Execute, depot, e->index, true, INVALID_CARGO, ClientID::Invalid);
+		if (bc.Failed()) continue;
+		Command<Commands::StartStopVehicle>::Do(DoCommandFlag::Execute, vid, false);
+		V3SLog("V3SFOTO: koupen puvodni nakladak engine {}", e->index.base());
+		puvodnich++;
+	}
+	for (const Nakup &n : nakupy) {
+		uint32_t want = (uint8_t)n.grf[0] | (uint8_t)n.grf[1] << 8 | (uint8_t)n.grf[2] << 16 | (uint32_t)(uint8_t)n.grf[3] << 24;
+		EngineID eid = EngineID::Invalid();
+		for (const Engine *e : Engine::IterateType(VehicleType::Road)) {
+			if (e->GetGRFID() == want && e->grf_prop.local_id == n.local) { eid = e->index; break; }
+		}
+		if (eid == EngineID::Invalid()) {
+			V3SLog("V3SFOTO: {} 0x{:04X} nenalezen", n.grf, n.local);
+			continue;
+		}
+		auto [bc, vid, bcap, bmail, bcaps] = Command<Commands::BuildVehicle>::Do(DoCommandFlag::Execute, depot, eid, true, INVALID_CARGO, ClientID::Invalid);
+		if (bc.Failed()) {
+			V3SLog("V3SFOTO: koupe {} 0x{:04X} SELHALA: {}", n.grf, n.local, bc.GetErrorMessage() == INVALID_STRING_ID ? std::string("?") : GetString(bc.GetErrorMessage()));
+			continue;
+		}
+		if (n.naklad[0] != '\0') {
+			uint32_t l = (uint32_t)(uint8_t)n.naklad[0] << 24 | (uint8_t)n.naklad[1] << 16 | (uint8_t)n.naklad[2] << 8 | (uint8_t)n.naklad[3];
+			CargoType ct = GetCargoTypeByLabel(CargoLabel{l});
+			if (IsValidCargoType(ct)) Command<Commands::RefitVehicle>::Do(DoCommandFlag::Execute, vid, ct, n.podtyp, false, false, 0);
+			if (IsValidCargoType(ct) && n.plne) {
+				for (RoadVehicle *u = RoadVehicle::From(Vehicle::Get(vid)); u != nullptr; u = u->Next()) {
+					if (u->cargo_cap > 0 && u->cargo_type == ct && CargoPacket::CanAllocateItem()) u->cargo.Append(CargoPacket::Create(StationID::Invalid(), u->cargo_cap, Source{}));
+				}
