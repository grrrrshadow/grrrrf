+static bool ConTestPruhy(std::span<std::string_view> argv)
+{
+	if (argv.empty()) {
+		IConsolePrint(CC_HELP, "Poradi kresleni aut proti sobe na rovne silnici. Usage: 'testpruhy x|y [tiku]'.");
+		return true;
+	}
+	if (_game_mode != GameMode::Normal) return true;
+	if (Company::GetIfValid(_local_company) == nullptr) {
+		extern Company *DoStartupNewCompany(bool is_ai, CompanyID company);
+		Company *made = DoStartupNewCompany(false, CompanyID::Invalid());
+		if (made == nullptr) return true;
+		SetLocalCompany(made->index);
+	}
+	Command<Commands::MoneyCheat>::Do(DoCommandFlag::Execute, 100000000);
+	if (_settings_game.vehicle.road_side != RoadVehicleDrivingSide::Right) {
+		V3SLog("PRUHY: hra jezdi vlevo, zkouska je pro pravostranny provoz");
+		return true;
+	}
+	const Axis osa = (argv.size() > 1 && argv[1] == "y") ? Axis::Y : Axis::X;
+	uint tiku = 30;
+	if (argv.size() > 2) {
+		tiku = 0;
+		for (char c : argv[2]) if (c >= '0' && c <= '9') tiku = tiku * 10 + (c - '0');
+	}
+	/* rovne prazdne misto: 21 dlazdic podel osy, 12 napric */
+	const uint DL = 21, SI = 12;
+	const uint W = osa == Axis::X ? DL : SI, H = osa == Axis::X ? SI : DL;
+	TileIndex zac = INVALID_TILE;
+	for (uint y = 10; y + H < Map::SizeY() - 10 && zac == INVALID_TILE; y++) {
+		for (uint x = 10; x + W < Map::SizeX() - 10; x++) {
+			bool ok = true;
+			int z0 = GetTileZ(TileXY(x, y));
+			for (uint dy = 0; dy < H && ok; dy++) for (uint dx = 0; dx < W && ok; dx++) {
+				TileIndex t = TileXY(x + dx, y + dy);
+				ok = (IsTileType(t, TileType::Clear) || IsTileType(t, TileType::Trees)) && GetTileSlope(t) == SLOPE_FLAT && GetTileZ(t) == z0;
+			}
+			if (ok) { zac = TileXY(x, y); break; }
+		}
+	}
+	if (zac == INVALID_TILE) {
+		V3SLog("PRUHY: neni misto");
+		return true;
+	}
+	const uint x0 = TileX(zac), y0 = TileY(zac);
+	RoadType rt = GetRoadTypeByLabel('R' << 24 | 'T' << 16 | '1' << 8 | '4', false);
+	if (rt == INVALID_ROADTYPE) rt = ROADTYPE_ROAD;
+	/* dlazdice podle polohy podel osy a napric */
+	auto dl = [&](uint podel, uint napric) { return osa == Axis::X ? TileXY(x0 + podel, y0 + napric) : TileXY(x0 + napric, y0 + podel); };
+	/* tri silnice napric 2, 5, 8, podel od 1 do 19; depo na zacatku prvni */
+	bool ok = true;
+	for (uint r = 0; r < 3; r++) {
+		ok = ok && Command<Commands::BuildRoadLong>::Do(DoCommandFlag::Execute, dl(19, 2 + 3 * r), dl(1, 2 + 3 * r), rt, osa, DisallowedRoadDirections{}, true, true, false).Succeeded();
+	}
+	const TileIndex depo = dl(0, 2);
+	const RoadBits k_depu = osa == Axis::X ? RoadBits{RoadBit::NE} : RoadBits{RoadBit::NW};
+	Command<Commands::BuildRoad>::Do(DoCommandFlag::Execute, dl(1, 2), k_depu, rt, DisallowedRoadDirections{}, TownID::Invalid());
+	ok = ok && Command<Commands::BuildRoadDepot>::Do(DoCommandFlag::Execute, depo, rt, osa == Axis::X ? DiagDirection::SW : DiagDirection::SE).Succeeded();
+	V3SLog("PRUHY: osa {} misto ({},{}) silnice a depo {}", osa == Axis::X ? "X" : "Y", x0, y0, ok ? "ok" : "CHYBA");
+
+	/* zadni pruh (X: jihozapad v y 5, Y: severozapad v x 5) a predni pruh (X: severovychod v y 9, Y: jihovychod v x 9) */
+	struct Typ { uint32_t grf; uint16_t local; };
+	auto ctyri = [](const char *s) { return (uint32_t)(uint8_t)s[0] | (uint8_t)s[1] << 8 | (uint8_t)s[2] << 16 | (uint32_t)(uint8_t)s[3] << 24; };
+	Typ zadni[3] = {{ctyri("MAX\x08"), 0x0093}, {ctyri("MAXd"), 0x0103}, {ctyri("MAX\x08"), 0x0091}};
+	Typ predni[3] = {{ctyri("MAXd"), 0x0102}, {ctyri("MAX\x08"), 0x0092}, {ctyri("MAX\x08"), 0x0080}};
+	/* TEST_PRUHY_AUTA="MAXd:0102/MAXd:0103;4D490203:0060/4D490203:005D;..." po radach: zadni pruh / predni pruh,
+	 * GRF jako 4 znaky nebo 8 sestnactkovych cislic (bajty v poradi, jak se pise grf_id) */
+	if (const char *env = getenv("TEST_PRUHY_AUTA"); env != nullptr) {
+		auto sestnact = [](std::string_view s) {
+			uint32_t v = 0;
+			for (char c : s) {
+				v <<= 4;
+				if (c >= '0' && c <= '9') v |= (uint32_t)(c - '0');
+				else if (c >= 'a' && c <= 'f') v |= (uint32_t)(c - 'a' + 10);
+				else if (c >= 'A' && c <= 'F') v |= (uint32_t)(c - 'A' + 10);
+			}
+			return v;
+		};
+		auto typ = [&](std::string_view s, Typ &out) {
+			auto dvojt = s.find(':');
+			if (dvojt == std::string_view::npos) return;
+			std::string_view g = s.substr(0, dvojt), l = s.substr(dvojt + 1);
+			uint32_t grf = 0;
+			if (g.size() == 8) {
+				for (int i = 0; i < 4; i++) grf |= sestnact(g.substr(i * 2, 2)) << (8 * i);
+			} else if (g.size() == 4) {
+				grf = (uint8_t)g[0] | (uint8_t)g[1] << 8 | (uint8_t)g[2] << 16 | (uint32_t)(uint8_t)g[3] << 24;
+			}
+			out.grf = grf;
+			out.local = (uint16_t)sestnact(l);
+		};
+		std::string_view v(env);
+		for (uint r = 0; r < 3 && !v.empty(); r++) {
+			auto konec = v.find(';');
+			std::string_view rada = v.substr(0, konec);
+			auto lomitko = rada.find('/');
+			if (lomitko != std::string_view::npos) {
+				typ(rada.substr(0, lomitko), zadni[r]);
+				typ(rada.substr(lomitko + 1), predni[r]);
+			}
+			v = konec == std::string_view::npos ? std::string_view{} : v.substr(konec + 1);
+		}
+	}
+	auto kup = [&](const Typ &t) -> RoadVehicle * {
+		const uint32_t want = t.grf;
+		for (const Engine *e : Engine::IterateType(VehicleType::Road)) {
+			if (e->GetGRFID() != want || e->grf_prop.local_id != t.local) continue;
+			auto [bc, vid, bcap, bmail, bcaps] = Command<Commands::BuildVehicle>::Do(DoCommandFlag::Execute, depo, e->index, true, INVALID_CARGO, ClientID::Invalid);
+			if (bc.Failed()) {
+				V3SLog("PRUHY: koupe {:08X} 0x{:04X} SELHALA: {} (dostupny {}, uveden {})", want, t.local, bc.GetErrorMessage() == INVALID_STRING_ID ? std::string("?") : GetString(bc.GetErrorMessage()), e->company_avail.Test(_local_company), e->intro_date.base());
+				return nullptr;
+			}
+			return RoadVehicle::From(Vehicle::Get(vid));
+		}
+		V3SLog("PRUHY: {:08X} 0x{:04X} nenalezen", want, t.local);
+		return nullptr;
+	};
+	/* 'kolona' (treti argument): misto dvojic zacpa v obou pruzich jako na hracove fotce, auta 10 osmin od sebe
+	 * (rozestup dvanacttrojky s narazniky), predni pruh posunuty o 5 proti zadnimu */
+	const bool kolona = argv.size() > 3 && argv[3] == "kolona";
+	for (uint r = 0; r < 3 && kolona; r++) {
+		const int napric = (int)(osa == Axis::X ? y0 : x0) + 2 + 3 * (int)r;
+		const int start = (int)(osa == Axis::X ? x0 : y0) * (int)TILE_SIZE;
+		for (uint i = 0; i < 12; i++) {
+			RoadVehicle *a = kup(i % 2 ? predni[r] : zadni[r]);
+			RoadVehicle *b = kup(i % 2 ? zadni[r] : predni[r]);
+			/* zadni pruh jede u X k vetsimu x, u Y k mensimu y; cela jdou od konce, kam jedou */
+			const int a_celo = osa == Axis::X ? start + 16 * (int)TILE_SIZE - 10 * (int)i : start + 4 * (int)TILE_SIZE + 10 * (int)i;
+			const int b_celo = osa == Axis::X ? start + 8 * (int)TILE_SIZE + 5 + 10 * (int)i : start + 12 * (int)TILE_SIZE - 5 - 10 * (int)i;
+			if (a != nullptr) PolozAutoNaSilnici(a, osa, osa == Axis::X, a_celo, napric);
+			if (b != nullptr) PolozAutoNaSilnici(b, osa, osa != Axis::X, b_celo, napric);
+		}
+	}
+	/* 'mrizka': v kazde rade stejny odstup cel (TEST_PRUHY_ODSTUP, jinak 6), ale dvojice posunuta po dlazdici:
+	 * celo predniho auta 0, 2, ..., 14 od kraje dlazdice (hrac: prevraci se to na care z leveho do praveho rohu dlazdice) */
+	const bool mrizka = argv.size() > 3 && argv[3] == "mrizka";
+	const char *odstup_env = getenv("TEST_PRUHY_ODSTUP");
+	int odstup_mrizky = 6;
+	if (odstup_env != nullptr && *odstup_env != '\0') {
+		odstup_mrizky = 0;
+		for (const char *c = odstup_env; *c >= '0' && *c <= '9'; c++) odstup_mrizky = odstup_mrizky * 10 + (*c - '0');
+	}
+	for (uint r = 0; r < 3 && !kolona; r++) {
+		const int napric = (int)(osa == Axis::X ? y0 : x0) + 2 + 3 * (int)r;
+		for (uint k = 0; k < 8; k++) {
+			const int d = mrizka ? odstup_mrizky : 2 * (int)k;
+			const int zaklad = ((int)(osa == Axis::X ? x0 : y0) + 3 + 2 * (int)k) * (int)TILE_SIZE;
+			const int b_celo = zaklad + (mrizka ? 2 * (int)k : (osa == Axis::X ? 4 : 12));
+			const int a_celo = osa == Axis::X ? b_celo + d : b_celo - d;
+			RoadVehicle *a = kup(zadni[r]);
+			RoadVehicle *b = kup(predni[r]);
+			if (a != nullptr) PolozAutoNaSilnici(a, osa, osa == Axis::X, a_celo, napric);
+			if (b != nullptr) PolozAutoNaSilnici(b, osa, osa != Axis::X, b_celo, napric);
+			for (RoadVehicle *v : {a, b}) {
+				for (RoadVehicle *u = v; u != nullptr; u = u->Next()) {
+					V3SLog("PRUHY: rada {} par {} odstup {} {} vuz {} dil 0x{:04X} delka {} x {} y {} smer {} box x {}..{} y {}..{}", r, k, d,
+							v == a ? "zadni" : "predni", v->unitnumber, u->GetEngine()->grf_prop.local_id, u->gcache.cached_veh_length,
+							u->x_pos, u->y_pos, to_underlying(u->direction),
+							u->x_pos + u->bounds.origin.x, u->x_pos + u->bounds.origin.x + u->bounds.extent.x - 1,
+							u->y_pos + u->bounds.origin.y, u->y_pos + u->bounds.origin.y + u->bounds.extent.y - 1);
+				}
+			}
+		}
+	}
+	_v3s_stred = dl(10, 5);
+	ScrollMainWindowToTile(_v3s_stred, true);
+	_v3s_foto_pocet = _v3s_foto_zbyva = 1;
+	_v3s_foto_krok = 100;
+	_v3s_foto_cislo = 0;
+	_v3s_foto_dalsi = TimerGameTick::counter + tiku;
+	V3SLog("PRUHY: fotka za {} tiku", tiku);
+	return true;
+}
