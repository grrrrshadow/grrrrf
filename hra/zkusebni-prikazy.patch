+/* ZKOUSKA PORADI KRESLENI (jen tahle kopie hry, 29. 9.): hrac videl na silnici SV-JZ, ze auto jedouci na jihozapad
+ * v zadnim pruhu se kresli pres auto v prednim pruhu (dvanacttrojky VW T1 s naraznikem vepredu i vzadu, sestava 1, 1, 1).
+ * 'testpruhy x|y [tiku]' postavi tri rovne silnice podel osy X (SV-JZ) nebo Y (SZ-JV) a na kazdou osm dvojic stojicich
+ * aut proti sobe, zadni pruh a predni pruh, cela od sebe 0 az 14 osmin dlazdice, jak se miji. Vyfoti je a hru ukonci. */
+static void PolozAutoNaSilnici(RoadVehicle *v, Axis osa, bool kladne, int celo, int napric)
+{
+	/* pravostranny provoz (tabulky 24, 16, 17, 25 v roadveh_movement.h): X kladne = jihozapad v y 5,
+	 * X zaporne = severovychod v y 9, Y kladne = jihovychod v x 9, Y zaporne = severozapad v x 5 */
+	const Trackdir td = osa == Axis::X ? (kladne ? Trackdir::X_SW : Trackdir::X_NE) : (kladne ? Trackdir::Y_SE : Trackdir::Y_NW);
+	const Direction dir = osa == Axis::X ? (kladne ? Direction::SW : Direction::NE) : (kladne ? Direction::SE : Direction::NW);
+	const int pruh = napric * (int)TILE_SIZE + (osa == Axis::X ? (kladne ? 5 : 9) : (kladne ? 9 : 5));
+	int za = 0;
+	for (RoadVehicle *u = v; u != nullptr; u = u->Next()) {
+		if (u != v) za += u->Previous()->gcache.cached_veh_length;
+		const int podel = kladne ? celo - za : celo + za;
+		const int px = osa == Axis::X ? podel : pruh;
+		const int py = osa == Axis::X ? pruh : podel;
+		u->tile = TileXY(px / (int)TILE_SIZE, py / (int)TILE_SIZE);
+		u->state = to_underlying(td);
+		u->frame = kladne ? (podel & 0xF) : 15 - (podel & 0xF);
+		u->x_pos = px;
+		u->y_pos = py;
+		u->direction = dir;
+		u->overtaking = 0;
+		u->cur_speed = 0;
+		u->vehstatus.Reset(VehState::Hidden);
+		u->UpdatePosition();
+		u->UpdateInclination(true, true);
+		u->UpdateViewport(true, true);
+	}
+}
