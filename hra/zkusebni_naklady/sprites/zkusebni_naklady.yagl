yagl_version: "";
grf_format: Container2;
grf // Action08
{
    grf_id: "MAXn";
    version: GRF8;
    name: "Zkušební náklady pro vejtřasku (jen pro zkušební hru)";
    description: "Náklady, které mírné klima nemá, aby šla ve zkušební hře vyzkoušet vejtřaska: kupky, pytle, sudy, seno, turisté, chemikálie, hračky, uran, voda, kyselina, káva, jíl, cukrová třtina, kaolín, cihly, stavební materiál, ovoce, studenti, víno a chmel. Do hry pro hráče nepatří.";
}
