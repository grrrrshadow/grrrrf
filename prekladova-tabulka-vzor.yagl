// ====================================================================
// VZOROVÁ PŘEKLADOVÁ TABULKA NÁKLADŮ (cargo translation table)
// ====================================================================
//
// Všech 146 labelů z tabulky NewGRF specs / CargoTypes, u každého
// česky co to je. Formát opsaný z VWT1cargo.yagl.
//
// K ČEMU TO JE: číslo slotu (instance_id) je to, čím se náklad
// označuje uvnitř tohohle GRF — v refit seznamech vozidel a podobně.
// Label je naopak to, čemu rozumí zbytek světa. Tahle tabulka ty dvě
// věci spojuje. Pořadí si tedy určujeme my, ale jakmile se na sloty
// začne někde odkazovat, přečíslování rozbije všechno, co na ně
// ukazuje. Proto: nové náklady přidávat NA KONEC, ne doprostřed.
//
// Tohle je vzor k proškrtání, ne hotová tabulka — 146 nákladů
// v jednom setu nikdo nechce. Smaž, co nepotřebuješ, a čísla slotů
// pak přečísluj odshora (nebo si nech mezery).
//
// POZOR: ještě jsem si neověřil, jaký je horní limit délky téhle
// tabulky v OpenTTD. VWT1cargo.yagl má 96 záznamů, takže 96 určitě
// projde. Než tuhle plnou verzi někam nasadíš, ověřit.
// ====================================================================

properties<GlobalSettings, 0x0000> // Action00
{

