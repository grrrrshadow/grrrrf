switch<RoadVehicles, 0x13, PrimaryDWord> // clanky (callback 0x16): 1 = viditelny autobus, dal nic
{
    expression:
    {
        value1 = variable[0x10] & 0x000000FF;
    };
    ranges:
    {
        0x00000001: 0x8110;
    };
    default: 0xFFFF;
}
switch<RoadVehicles, 0x14, PrimaryDWord> // cumak: clanky, jinak prazdny sprite
{
    expression:
    {
        value1 = variable[0x0C] & 0x0000FFFF;
    };
    ranges:
    {
        0x00000016: 0x0013;
    };
    default: 0x0011;
}
switch<RoadVehicles, 0x15, PrimaryDWord> // nakup: clanky, popis, obrazek
{
    expression:
    {
        value1 = variable[0x0C] & 0x0000FFFF;
    };
    ranges:
    {
        0x00000016: 0x0013;
        0x00000023: 0x8001;
    };
    default: 0x0012;
}
