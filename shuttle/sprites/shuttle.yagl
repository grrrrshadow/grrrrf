yagl_version: "";
grf_format: Container2;

// ====================================================================
// shuttle.grf
// ====================================================================
// Soubor, .yagl i name: v Action08 se jmenuji stejne - "shuttle".
//
// TRI sady spritu po osmi smerech. Prepina se mezi nimi podle
// promenne 0xE2 (faze pohybu letadla), stejne jako to dela CZTR:
//
//     0x0F       = 15  CLIMBING         -> stoupani, cumak nahoru
//     0x15       = 21  FLIGHT_DESCENT   -> klesani, cumak dolu
//     vse ostatni                       -> rovne
//
// Rovna sada slouzi i pro vodorovny let (16, 18) - letadlo v nem
// skutecne rovne je - a pro vsechno na zemi.
//
// Sprity renderovane z glbobj/Shuttle.glb skriptem glb3letadlo.py,
// klopeni HILL_TILT_DEGREES: 0 / -12 / +12.
// ====================================================================

grf // Action08
{
    grf_id: "GRSH";
    version: GRF8;
    name: "shuttle";
    description: "{orange}Shuttle{new-line}{black}Zkusebni letadlo se spritama pro stoupani a klesani.{new-line}Licence: GPL v2";
}

sprite_sets<Aircraft, 0x0000> // Action01
{
    sprite_set // 0x0000 - rovne (rovny let, pojizdeni, stani)
    {
        sprite_id<0x00000001>   // N
        {
            [70, 114, -35, -57], zin4, c32bpp | chunked, "shuttle-32bpp-zin4-0.png", [4, 4];
        }
        sprite_id<0x00000002>   // NE
        {
            [173, 101, -86, -50], zin4, c32bpp | chunked, "shuttle-32bpp-zin4-0.png", [208, 4];
        }
        sprite_id<0x00000003>   // E
