            [200, 59, -100, -29], zin4, c32bpp | chunked, "shuttle-32bpp-zin4-0.png", [1228, 4];
        }
        sprite_id<0x00000008>   // NW
        {
            [174, 101, -87, -50], zin4, c32bpp | chunked, "shuttle-32bpp-zin4-0.png", [1432, 4];
        }
    }
    sprite_set // 0x0001 - stoupani (cumak nahoru)
    {
        sprite_id<0x00000009>   // N
        {
            [70, 144, -35, -72], zin4, c32bpp | chunked, "shuttle-32bpp-zin4-0.png", [4, 155];
        }
        sprite_id<0x0000000A>   // NE
        {
            [171, 130, -85, -65], zin4, c32bpp | chunked, "shuttle-32bpp-zin4-0.png", [208, 155];
        }
        sprite_id<0x0000000B>   // E
        {
            [199, 76, -99, -38], zin4, c32bpp | chunked, "shuttle-32bpp-zin4-0.png", [412, 155];
